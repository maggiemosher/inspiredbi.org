    appraiser:"Worked example", date:"2026-08-25", type:"narrative", framework:"PEO", field:"social"
  },
  ans:{
    A1:"yes", A2:"partial", A3:"partial", A4:"partial", A5:"yes", A6:"yes",
    B1:"no", B2:"no", B3:"na", B4:"yes",
