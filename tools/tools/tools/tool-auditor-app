<!doctype html><html><head><meta charset=utf8><meta name="robots" content="noindex, nofollow"><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found]){display:none!important}</style></head><body>
<title>The Tool Auditor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">

<style>
:root{
  --paper:#EFF0F4; --surface:#FFFFFF; --surface-2:#F7F7FA;
  --ink:#1A1D2E; --ink-2:#4A4E63; --ink-3:#7A7E92;
  --line:#DBDCE4; --line-2:#C7C8D4;
  --accent:#3B3F72; --accent-2:#5A5F9B; --accent-wash:#E7E8F2; --on-accent:#FFFFFF;
  --good:#256B4E; --good-wash:#DFEDE6;
  --warn:#9C6407; --warn-wash:#F5E9D5;
  --bad:#A6302A; --bad-wash:#F5E0DE;
  --na:#75798C; --na-wash:#E6E7EC;
  --shadow:0 1px 2px rgba(26,29,46,.05), 0 8px 24px -12px rgba(26,29,46,.18);
  --serif:"Newsreader",Georgia,"Times New Roman",serif;
  --sans:"IBM Plex Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#14151C; --surface:#1C1E28; --surface-2:#22242F;
    --ink:#E7E8EF; --ink-2:#A9ACBC; --ink-3:#7E8294;
    --line:#2E3040; --line-2:#3C3F52;
    --accent:#A2A8E4; --accent-2:#8A90D0; --accent-wash:#262941; --on-accent:#14151C;
    --good:#6FC49B; --good-wash:#1B3830;
    --warn:#D9A34E; --warn-wash:#3A2E19;
    --bad:#E4837C; --bad-wash:#3B2222;
    --na:#8E92A6; --na-wash:#292B37;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 28px -14px rgba(0,0,0,.7);
  }
}
:root[data-theme="dark"]{
  --paper:#14151C; --surface:#1C1E28; --surface-2:#22242F;
  --ink:#E7E8EF; --ink-2:#A9ACBC; --ink-3:#7E8294;
  --line:#2E3040; --line-2:#3C3F52;
  --accent:#A2A8E4; --accent-2:#8A90D0; --accent-wash:#262941; --on-accent:#14151C;
  --good:#6FC49B; --good-wash:#1B3830;
  --warn:#D9A34E; --warn-wash:#3A2E19;
  --bad:#E4837C; --bad-wash:#3B2222;
  --na:#8E92A6; --na-wash:#292B37;
  --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 28px -14px rgba(0,0,0,.7);
}

*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
button{font-family:inherit;font-size:inherit;color:inherit;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}
h1,h2,h3,h4{margin:0;text-wrap:balance}
a{color:var(--accent-2)}

.masthead{border-bottom:1px solid var(--line);background:var(--surface);position:sticky;top:0;z-index:60}
.masthead-in{max-width:1320px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:22px;flex-wrap:wrap}
.wordmark{display:flex;align-items:baseline;gap:10px;margin-right:auto}
.wordmark h1{font-family:var(--serif);font-weight:500;font-size:23px;letter-spacing:-.01em;line-height:1}
.wordmark .sub{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3)}
.tabs{display:flex;background:var(--surface-2);border:1px solid var(--line);border-radius:6px;padding:2px;gap:2px}
.tabs button{border:0;background:transparent;padding:5px 14px;border-radius:4px;font-size:13px;font-weight:500;color:var(--ink-2)}
.tabs button[aria-selected="true"]{background:var(--accent);color:var(--on-accent)}
.btn{border:1px solid var(--line-2);background:var(--surface);border-radius:6px;padding:6px 12px;font-size:13px;font-weight:500;color:var(--ink-2);transition:border-color .12s,color .12s}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn.on{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}

.shell{max-width:1320px;margin:0 auto;padding:22px 24px 60px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow)}
.hidden{display:none !important}

/* standing finding */
.standing{padding:18px 22px;margin-bottom:20px;border-left:3px solid var(--bad)}
.standing .lab{font-family:var(--mono);font-size:9.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--bad);font-weight:600}
.standing h2{font-family:var(--serif);font-size:22px;font-weight:500;margin-top:8px;letter-spacing:-.01em;line-height:1.25}
.standing p{margin:10px 0 0;font-size:13.5px;line-height:1.6;color:var(--ink-2);max-width:88ch}
.standing p b{color:var(--ink);font-weight:600}

/* picker */
.pickwrap{margin-bottom:20px;padding:18px 20px}
.pickwrap h3,.secttl{font-family:var(--mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);font-weight:500;margin-bottom:12px}
.pickrow{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
#tool-input{flex:1;min-width:240px;border:1px solid var(--line-2);background:var(--surface-2);border-radius:6px;padding:9px 11px;font-size:14px}
.suggest{margin-top:12px;display:flex;flex-wrap:wrap;gap:6px}
.pill{border:1px solid var(--line-2);background:var(--surface-2);border-radius:20px;padding:4px 12px;font-size:12.5px;color:var(--ink-2)}
.pill:hover{border-color:var(--accent);color:var(--accent)}
.pill.cur{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.catlab{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);width:100%;margin:8px 0 2px}

/* profile */
.grid2{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:20px;align-items:start}
@media (max-width:1040px){.grid2{grid-template-columns:minmax(0,1fr)}}
.phead{padding:22px 24px;border-bottom:1px solid var(--line)}
.pname{font-family:var(--serif);font-size:29px;font-weight:500;letter-spacing:-.018em;line-height:1.15}
.pmeta{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;color:var(--ink-3);margin-top:7px}
.pmeta a{color:var(--ink-3)}
.role{display:inline-block;margin-top:12px;font-family:var(--serif);font-size:19px;padding:4px 13px;border-radius:5px;border:1px solid}
.r-good{background:var(--good-wash);border-color:var(--good);color:var(--good)}
.r-warn{background:var(--warn-wash);border-color:var(--warn);color:var(--warn)}
.r-bad{background:var(--bad-wash);border-color:var(--bad);color:var(--bad)}
.pverdict{margin-top:14px;font-size:14.5px;line-height:1.6;max-width:72ch;color:var(--ink)}

/* stage matrix */
.stages{padding:20px 24px;border-bottom:1px solid var(--line)}
.stagerow{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px;margin-top:12px}
.stage{border:1px solid var(--line);border-radius:6px;padding:9px 8px 10px;text-align:center;background:var(--surface-2)}
.stage .sn{font-family:var(--mono);font-size:9px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-3);display:block;line-height:1.3;min-height:24px}
.stage .sv{font-size:11.5px;font-weight:700;margin-top:7px;letter-spacing:.01em}
.s-primary{background:var(--good-wash);border-color:var(--good)} .s-primary .sv{color:var(--good)}
.s-assistive{background:var(--warn-wash);border-color:var(--warn)} .s-assistive .sv{color:var(--warn)}
.s-unfit{background:var(--bad-wash);border-color:var(--bad)} .s-unfit .sv{color:var(--bad)}
.s-na{background:var(--na-wash);border-color:var(--line-2)} .s-na .sv{color:var(--na)}
.stagenote{font-size:12px;color:var(--ink-3);margin-top:11px;line-height:1.5;max-width:80ch}
@media (max-width:720px){.stagerow{grid-template-columns:repeat(3,minmax(0,1fr))}}

/* gates */
.gates{padding:18px 24px;border-bottom:1px solid var(--line)}
.gatelist{display:flex;flex-direction:column;gap:9px;margin-top:10px}
.gate{display:flex;gap:11px;align-items:flex-start;font-size:13px;line-height:1.45}
.gmark{font-family:var(--mono);font-size:11px;font-weight:700;flex:none;width:20px;text-align:center;padding-top:1px}
.g-pass{color:var(--good)} .g-part{color:var(--warn)} .g-fail{color:var(--bad)} .g-unk{color:var(--na)}
.gate .gl{color:var(--ink-2)} .gate .gl b{color:var(--ink);font-weight:600}

/* facts + evidence */
.fact{padding:16px 24px;border-bottom:1px solid var(--line)}
.fact h4,.railsec h4{font-family:var(--mono);font-size:9.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);font-weight:500;margin-bottom:8px}
.fact p{margin:0;font-size:13.5px;line-height:1.6;color:var(--ink-2);max-width:80ch}
.evlist{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:11px}
.evlist li{font-size:13px;line-height:1.55;color:var(--ink-2);padding-left:15px;position:relative;max-width:82ch}
.evlist li::before{content:"";position:absolute;left:0;top:7px;width:6px;height:6px;border-radius:1px;background:var(--accent-2)}

/* criteria */
.dim{border-bottom:1px solid var(--line)}
.dim:last-child{border-bottom:0}
.dhead{display:flex;align-items:center;gap:12px;padding:12px 24px;background:var(--surface-2);cursor:pointer;user-select:none;border-bottom:1px solid var(--line)}
.dhead .di{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--accent);width:24px;flex:none}
.dhead h4{font-family:var(--serif);font-size:17px;font-weight:500;flex:1;letter-spacing:-.005em}
.dhead .dsc{font-family:var(--mono);font-size:11.5px;font-weight:600;color:var(--ink-2);font-variant-numeric:tabular-nums}
.chev{color:var(--ink-3);font-size:11px;transition:transform .18s;flex:none}
.dim.collapsed .chev{transform:rotate(-90deg)}
.dim.collapsed .dbody{display:none}
.crit{padding:13px 24px;border-bottom:1px solid var(--line);display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap}
.crit:last-child{border-bottom:0}
.crit .cq{flex:1;min-width:250px}
.crit .cl{font-size:13.5px;font-weight:500;line-height:1.45}
.crit .ch{font-size:12px;color:var(--ink-3);margin-top:4px;line-height:1.45;max-width:70ch}
.ctag{font-family:var(--mono);font-size:9px;letter-spacing:.05em;color:var(--ink-3);border:1px solid var(--line);background:var(--surface-2);padding:1px 5px;border-radius:3px;margin-right:5px}
.ctag.gate{color:var(--bad);border-color:var(--bad);background:var(--bad-wash);font-weight:600}
.pick4{display:flex;gap:3px;flex:none}
.pick4 button{border:1px solid var(--line-2);background:var(--surface);border-radius:5px;padding:4px 8px;font-size:11px;font-weight:600;color:var(--ink-3);min-width:38px}
.pick4 button[data-on="1"][data-v="2"]{background:var(--good-wash);border-color:var(--good);color:var(--good)}
.pick4 button[data-on="1"][data-v="1"]{background:var(--warn-wash);border-color:var(--warn);color:var(--warn)}
.pick4 button[data-on="1"][data-v="0"]{background:var(--bad-wash);border-color:var(--bad);color:var(--bad)}
.pick4 button[data-on="1"][data-v="-1"]{background:var(--na-wash);border-color:var(--na);color:var(--na)}
.pick4 button[data-on="1"][data-v="-2"]{background:var(--surface-2);border-color:var(--line-2);color:var(--ink-3)}

/* rail */
.rail{position:sticky;top:80px;display:flex;flex-direction:column;gap:16px}
@media (max-width:1040px){.rail{position:static}}
.railsec{padding:16px 20px;border-bottom:1px solid var(--line)}
.railsec:last-child{border-bottom:0}
.bigscore{font-family:var(--serif);font-size:44px;font-weight:500;line-height:1;font-variant-numeric:tabular-nums}
.bigsub{font-size:12px;color:var(--ink-3);margin-top:6px;line-height:1.45}
.track{height:6px;background:var(--surface-2);border:1px solid var(--line);border-radius:3px;overflow:hidden;margin-top:10px}
.fill{height:100%;transition:width .3s ease}
.f-good{background:var(--good)}.f-warn{background:var(--warn)}.f-bad{background:var(--bad)}
.dimbar{display:flex;flex-direction:column;gap:9px}
.dbrow{display:grid;grid-template-columns:1fr 46px;gap:8px;align-items:center;font-size:12.5px}
.dbrow .dbn{color:var(--ink-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dbrow .dbv{font-family:var(--mono);font-size:11.5px;font-weight:600;text-align:right;font-variant-numeric:tabular-nums}
.dbtrack{grid-column:1/-1;height:4px;background:var(--surface-2);border-radius:2px;overflow:hidden;margin-top:-4px}
.unk{font-size:12px;color:var(--warn);line-height:1.45}

/* compare */
.cmpwrap{overflow-x:auto}
.cmp{width:100%;border-collapse:collapse;font-size:13px;min-width:900px}
.cmp th{text-align:left;font-family:var(--mono);font-size:9px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3);font-weight:500;padding:0 8px 9px 0;border-bottom:1px solid var(--line);vertical-align:bottom}
.cmp td{padding:10px 8px 10px 0;border-bottom:1px solid var(--line);vertical-align:middle}
.cmp td.nm{font-weight:600;min-width:180px}
.cmp td.nm small{display:block;font-weight:400;color:var(--ink-3);font-size:11.5px;margin-top:2px}
.cmp td.sc{font-family:var(--mono);font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.chip{display:inline-block;width:100%;text-align:center;font-family:var(--mono);font-size:9.5px;font-weight:700;padding:4px 2px;border-radius:4px;border:1px solid;letter-spacing:.03em}
.c-primary{background:var(--good-wash);border-color:var(--good);color:var(--good)}
.c-assistive{background:var(--warn-wash);border-color:var(--warn);color:var(--warn)}
.c-unfit{background:var(--bad-wash);border-color:var(--bad);color:var(--bad)}
.c-na{background:var(--na-wash);border-color:var(--line-2);color:var(--na)}
.cmp td.st{width:74px;padding-right:5px}
.rmv{border:0;background:transparent;color:var(--ink-3);font-size:15px;padding:2px 6px;line-height:1}
.rmv:hover{color:var(--bad)}
.empty{padding:40px 24px;text-align:center;color:var(--ink-3);font-size:14px}
.bestrow{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-top:12px}
.bestbox{border:1px solid var(--line);border-radius:6px;padding:12px 14px;background:var(--surface-2)}
.bestbox .bl{font-family:var(--mono);font-size:9px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3)}
.bestbox .bv{font-family:var(--serif);font-size:17px;font-weight:500;margin-top:5px;line-height:1.25}
.bestbox .bn{font-size:11.5px;color:var(--ink-3);margin-top:4px;line-height:1.4}

/* disclosure */
.disc{max-width:860px;margin:0 auto;padding:32px 36px}
.disc h2{font-family:var(--serif);font-size:27px;font-weight:500;letter-spacing:-.018em}
.disc p{font-size:14px;line-height:1.65;color:var(--ink-2);max-width:70ch}
.disc label{display:block;font-size:11.5px;font-weight:600;color:var(--ink-2);margin:16px 0 5px}
.disc input,.disc textarea{width:100%;border:1px solid var(--line-2);background:var(--surface-2);border-radius:5px;padding:8px 10px;font-size:13.5px}
.out{margin-top:18px;border:1px solid var(--line-2);border-radius:6px;background:var(--surface-2);padding:16px 18px;font-size:13.5px;line-height:1.7;white-space:pre-wrap}
.rule{height:1px;background:var(--line);margin:24px 0}
.footnote{max-width:1320px;margin:0 auto;padding:6px 24px 48px;font-size:11.5px;color:var(--ink-3);line-height:1.65}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(14px);background:var(--ink);color:var(--paper);padding:9px 18px;border-radius:6px;font-size:13px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:200}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

.stds{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.std{border:1px solid var(--line-2);background:var(--surface-2);border-radius:20px;padding:4px 13px;font-size:12.5px;font-weight:500;color:var(--ink-2)}
.std:hover{border-color:var(--accent);color:var(--accent)}
.ref{padding:16px 0;border-bottom:1px solid var(--line);scroll-margin-top:88px}
.ref:last-child{border-bottom:0}
.ref h4{font-family:var(--serif);font-size:19px;font-weight:500;letter-spacing:-.005em}
.ref .rk{font-family:var(--mono);font-size:9.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);margin-bottom:5px}
.ref p{margin:8px 0 0;font-size:13.5px;line-height:1.65;color:var(--ink-2);max-width:84ch}
.ref p b{color:var(--ink);font-weight:600}
.ref.flash{background:var(--accent-wash);border-radius:6px;padding-left:14px;padding-right:14px;transition:background .5s}
@media (prefers-reduced-motion:reduce){*{transition:none !important}}
</style>

<div class="masthead">
  <div class="masthead-in">
    <div class="wordmark">
      <h1>The Tool Auditor</h1>
      <span class="sub">AI fitness for evidence synthesis</span>
    </div>
    <div class="tabs" role="tablist">
      <button role="tab" id="tab-assess" aria-selected="true">Assess</button>
      <button role="tab" id="tab-compare" aria-selected="false">Compare</button>
      <button role="tab" id="tab-disclose" aria-selected="false">Disclosure</button>
    </div>
    <a class="btn" id="lnk-prov" href="where-does-it-come-from-app.html" target="_blank" rel="noopener">Where does it come from →</a>
  </div>
</div>

<div class="shell" id="v-assess">
  <section class="card standing">
    <div class="lab">Standing finding · verified September 2026</div>
    <h2>No AI tool currently qualifies as the sole search method for a publishable systematic review.</h2>
    <p>Not because the models are weak, but for three structural reasons: <b>the search is not reproducible</b>, <b>retrieval is capped</b>, and <b>the corpus has known gaps</b>. So this page does not score whether a tool can run your review. It scores <b>which stage each tool is fit for, and in what role</b>.</p>
    <div class="stds" id="stds"></div>
  </section>

  <section class="card pickwrap">
    <h3>Assess a tool</h3>
    <div class="pickrow">
      <input id="tool-input" placeholder="Type a tool name or paste a URL — Consensus, Elicit, scite.ai, Covidence, Gemini…" autocomplete="off">
      <button class="btn on" id="btn-assess">Assess</button>
    </div>
    <div class="suggest" id="suggest"></div>
  </section>

  <div class="grid2">
    <main>
      <section class="card" id="profile"></section>
    </main>
    <aside class="rail">
      <section class="card" id="rail"></section>
    </aside>
  </div>
</div>

<div class="shell hidden" id="v-compare">
  <section class="card" style="padding:20px 24px">
    <h3 class="secttl">Best fit by stage</h3>
    <div class="bestrow" id="bestrow"></div>
  </section>
  <section class="card" style="margin-top:18px;padding:20px 24px">
    <h3 class="secttl">The bench</h3>
    <div class="cmpwrap"><table class="cmp" id="cmp"></table></div>
    <div class="empty hidden" id="cmp-empty">Nothing on the bench yet. Assess a tool, then press <b>Add to comparison</b>.</div>
  </section>
</div>

<div class="shell hidden" id="v-disclose">
  <section class="card disc">
    <h2>AI use disclosure</h2>
    <p>The joint position statement requires that any use of AI or automation which makes or suggests judgements be fully and transparently reported: system names, versions and dates; the purposes and stages affected; justification of methodological soundness; validation evidence; limitations and biases; and financial interests. <b>PRISMA-trAIce</b> (<i>JMIR AI</i> 2025;1:e80247) is the reporting extension for exactly this. Fill in the two fields and this builds the paragraph from the tools on your bench.</p>
    <label for="d-review">Review title or short description</label>
    <input id="d-review" placeholder="e.g. a systematic review of digital distraction in higher education">
    <label for="d-dates">Dates of AI use</label>
    <input id="d-dates" placeholder="e.g. March–June 2026">
    <div class="rule"></div>
    <h3 class="secttl">Generated disclosure</h3>
    <div class="out" id="d-out"></div>
    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn on" id="btn-copy-disc">Copy disclosure</button>
