var STAGES = [
  {k:"scope",   n:"Scope &amp; question", cap:"assistive"},
  {k:"search",  n:"Search",               cap:"primary"},
  {k:"screen",  n:"Screen &amp; select",  cap:"primary"},
  {k:"extract", n:"Extract &amp; code",   cap:"primary"},
  {k:"appraise",n:"Appraise bias",        cap:"primary"},
  {k:"synth",   n:"Synthesise",           cap:"assistive"},
  {k:"report",  n:"Report",               cap:"primary"}
];

var VALS = [[2,"Full"],[1,"Part"],[0,"None"],[-1,"?"],[-2,"N/A"]];

/* ---------- state ---------- */
var state = {cur:null, custom:{}, bench:[], collapsed:{}, disc:{review:"",dates:""}};
var KEY = "tool-auditor-v1";
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(e){} }
function load(){
  try{
    var o = JSON.parse(localStorage.getItem(KEY)||"null");
    if(o && typeof o==="object"){
      state.cur=o.cur||null; state.custom=o.custom||{}; state.bench=o.bench||[];
      state.collapsed=o.collapsed||{}; state.disc=o.disc||{review:"",dates:""};
    }
  }catch(e){}
}
function all(){ var m={}; for(var k in TOOLS) m[k]=TOOLS[k]; for(var c in state.custom) m[c]=state.custom[c]; return m; }
function get(k){ return all()[k]; }
function vals(k){
  var t = get(k); if(!t) return null;
  var base = t.v.slice();
  var ov = (state.custom[k] && state.custom[k].ov) || (TOOLS[k] && state.custom["ov:"+k]) || null;
  if(state.custom["ov:"+k]) ov = state.custom["ov:"+k];
  if(ov) for(var i in ov) base[+i] = ov[i];
  return base;
}
function setVal(k,i,v){
  var key = "ov:"+k;
  if(!state.custom[key]) state.custom[key] = {};
  state.custom[key][i] = v;
  save();
}

/* ---------- scoring ---------- */
function score(v){
  var e=0,p=0,unk=0,na=0;
  CRIT.forEach(function(c){
    var x = v[c.i];
    if(x===-2){ na++; return; }
    p += c.w*2;
    if(x===-1){ unk++; return; }
    e += c.w*x;
  });
  return {pct: p>0?Math.round(100*e/p):0, unk:unk, na:na};
}
function dimScore(v, d){
  var e=0,p=0;
  CRIT.forEach(function(c){
    if(c.i < d.from[0] || c.i >= d.from[1]) return;
    var x=v[c.i]; if(x===-2) return;
    p += c.w*2; if(x===-1) return; e += c.w*x;
  });
  return p>0?Math.round(100*e/p):null;
}
function stageFit(v){
  var c = function(n){ return v[n-1]; };
  var r = {};
  /* a stage whose driving criterion is Not Applicable is not a failure — the tool
     simply does not operate at that stage. Grey, not red. */
  r.search   = c(1)===-2 ? "na"
             : (c(1)<1 || c(12)<1) ? "unfit"
             : (c(5)>=1 && c(7)>=2 && c(8)>=1 && c(9)>=1 && c(22)>=1) ? "primary" : "assistive";
  r.screen   = c(15)===-2 ? "na"
             : (c(15)<1 && c(16)<1 && c(18)<1 && c(23)<1) ? "unfit"
             : (c(15)>=2 && c(16)>=2 && c(24)>=1) ? "primary" : "assistive";
  r.extract  = c(19)===-2 ? "na"
             : (c(19)<1) ? "unfit"
             : (c(19)>=2 && c(20)>=2 && c(24)>=1) ? "primary" : "assistive";
  r.appraise = c(21)===-2 ? "na" : (c(21)<1) ? "unfit" : (c(21)>=2 && c(24)>=1) ? "primary" : "assistive";
  r.scope    = c(12)===-2 ? "na" : (c(12)<1) ? "unfit" : "assistive";
  r.synth    = c(13)===-2 ? "na" : (c(13)<1) ? "unfit" : "assistive";
  r.report   = c(18)===-2 ? "na"
             : (c(18)<1 && c(26)<1) ? "unfit"
             : (c(18)>=2 && c(24)>=2 && c(26)>=1) ? "primary" : "assistive";
  return r;
}
function role(fit, v){
  if(v && v.every(function(x){ return x===-1; })) return {t:"Not yet assessed", c:"r-warn"};
  if(fit.search==="primary") return {t:"Reproducible search platform", c:"r-good"};
  if(fit.screen==="primary" && fit.report==="primary") return {t:"Review management platform", c:"r-good"};
  if(fit.screen==="primary") return {t:"Screening platform", c:"r-good"};
  if(fit.extract==="primary" || fit.appraise==="primary") return {t:"Extraction and appraisal platform", c:"r-good"};
  if(fit.screen==="assistive" && (fit.extract==="assistive" || fit.appraise==="assistive")) return {t:"Assistive review workspace", c:"r-warn"};
  if(fit.screen==="assistive") return {t:"Screening prioritisation aid", c:"r-warn"};
  if(fit.search==="assistive") return {t:"Discovery and scoping adjunct", c:"r-warn"};
  if(fit.synth==="assistive") return {t:"Post-retrieval synthesis aid", c:"r-warn"};
  return {t:"Not fit for systematic review work", c:"r-bad"};
}
function fitLabel(f){ return f==="primary"?"Primary":f==="assistive"?"Assistive":f==="na"?"n/a":"Unfit"; }
function col(p){ return p>=75?"var(--good)":p>=50?"var(--warn)":"var(--bad)"; }
function fillC(p){ return p>=75?"f-good":p>=50?"f-warn":"f-bad"; }

/* ---------- helpers ---------- */
function esc(s){ return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];}); }
var tt;
function toast(m){ var t=document.getElementById("toast"); t.textContent=m; t.classList.add("show"); clearTimeout(tt); tt=setTimeout(function(){t.classList.remove("show");},2200); }

/* ---------- picker ---------- */
var CATN = {A:"AI research and search tools", B:"Systematic review platforms", C:"General assistants", X:"Your own entries"};
function renderSuggest(){
  var wrap = document.getElementById("suggest");
  var m = all(), cats = {A:[],B:[],C:[],X:[]};
  Object.keys(m).forEach(function(k){
    if(k.indexOf("ov:")===0) return;
    cats[m[k].cat||"X"].push(k);
  });
  var h = "";
  ["A","B","C","X"].forEach(function(c){
    if(!cats[c].length) return;
    h += '<div class="catlab">'+CATN[c]+'</div>';
    cats[c].forEach(function(k){
      h += '<button class="pill'+(state.cur===k?" cur":"")+'" data-k="'+k+'">'+esc(m[k].name)+'</button>';
    });
  });
  wrap.innerHTML = h;
  wrap.querySelectorAll(".pill").forEach(function(b){
    b.addEventListener("click", function(){ state.cur = b.dataset.k; save(); render(); });
  });
}

function resolve(q){
  q = q.trim().toLowerCase();
  if(!q) return null;
  var m = all(), keys = Object.keys(m).filter(function(k){return k.indexOf("ov:")!==0;});
  var host = q.replace(/^https?:\/\//,"").replace(/^www\./,"").split(/[\/?#]/)[0];
  for(var i=0;i<keys.length;i++){
    var t = m[keys[i]];
    var th = (t.url||"").replace(/^https?:\/\//,"").replace(/^www\./,"").split(/[\/?#]/)[0];
    if(host && th && (host===th || th.indexOf(host)===0 || host.indexOf(th)===0)) return keys[i];
  }
  for(var j=0;j<keys.length;j++){
    var n = m[keys[j]].name.toLowerCase();
    if(n===q || keys[j]===q.replace(/[^a-z0-9]/g,"")) return keys[j];
  }
  for(var p=0;p<keys.length;p++){
    if(m[keys[p]].name.toLowerCase().indexOf(q)>=0) return keys[p];
  }
  return null;
}

function createCustom(raw){
  var isUrl = /^https?:\/\//i.test(raw) || /\.[a-z]{2,}($|\/)/i.test(raw);
  var name = isUrl ? raw.replace(/^https?:\/\//i,"").replace(/^www\./i,"").split(/[\/?#]/)[0] : raw;
  var key = "x_" + name.toLowerCase().replace(/[^a-z0-9]+/g,"") + "_" + Date.now().toString(36);
  state.custom[key] = {
    name: name, cat:"X", url: isUrl ? (/^https?:/i.test(raw)?raw:"https://"+raw) : "",
    corpus:"Not yet recorded. Note what this tool actually searches — a named bibliographic index, the open web, or only your own uploads.",
    cap:"Not yet recorded. Note any cap on the number of results returned or exportable.",
    verdict:"Unassessed. Work down the criteria below; every unanswered item scores as zero, which is the conservative reading Cochrane's CESAR criteria call for.",
    ev:["No evidence recorded yet. Look for an independent peer-reviewed evaluation — a vendor whitepaper or conference poster does not count."],
    v: CRIT.map(function(){return -1;}),
    verified: new Date().toISOString().slice(0,10)
  };
  state.cur = key; save(); return key;
}

/* ---------- render profile ---------- */
function render(){
  renderSuggest();
  var p = document.getElementById("profile"), r = document.getElementById("rail");
  if(!state.cur || !get(state.cur)){
    p.innerHTML = '<div class="empty">Choose a tool above, or type any name or URL and press Assess to score one that is not listed.</div>';
    r.innerHTML = '<div class="railsec"><h4>Fitness score</h4><div class="bigsub">Nothing assessed yet.</div></div>';
    renderCompare(); renderDisclosure();
    return;
  }
  var t = get(state.cur), v = vals(state.cur), s = score(v), fit = stageFit(v), ro = role(fit, v);

  var h = '<div class="phead">';
  h += '<div class="pname">'+esc(t.name)+'</div>';
  h += '<div class="pmeta">'+ (CATN[t.cat]||"Custom entry") +
       (t.url ? ' · <a href="'+esc(t.url)+'" target="_blank" rel="noopener">'+esc(t.url.replace(/^https?:\/\//,""))+'</a>' : "") +
       ' · verified '+esc(t.verified)+'</div>';
  h += '<div class="role '+ro.c+'">'+ro.t+'</div>';
  h += '<div class="pverdict">'+esc(t.verdict)+'</div>';
  h += '</div>';

  h += '<div class="stages"><h4 class="secttl" style="margin:0">Stage fitness</h4><div class="stagerow">';
  STAGES.forEach(function(st){
    var f = fit[st.k];
    h += '<div class="stage s-'+f+'"><span class="sn">'+st.n+'</span><span class="sv">'+fitLabel(f)+'</span></div>';
  });
  h += '</div><div class="stagenote"><b>Primary</b> means the tool can carry that stage on its own record. <b>Assistive</b> means it may support the stage under human verification — as a second reviewer, a supplement, or a drafting aid — and must be reported as such. <b>Unfit</b> means it should not be used for that stage at all, and <b>n/a</b> means the tool does not operate at that stage — a screening platform does not search, and that is not a failing. Two stages are capped at Assistive by design: <b>scope</b> and <b>synthesis</b> are where the joint position statement makes the synthesist “ultimately responsible”, and no tool can hold that responsibility for you.</div></div>';

  h += '<div class="gates"><h4 class="secttl" style="margin:0">Hard gates</h4><div class="gatelist">';
  CRIT.filter(function(c){return c.gate;}).forEach(function(c){
    var x = v[c.i];
    var cls = x===2?"g-pass":x===1?"g-part":x===-1?"g-unk":x===-2?"g-unk":"g-fail";
    var mk  = x===2?"✓":x===1?"~":x===-1?"?":x===-2?"—":"✗";
    h += '<div class="gate"><span class="gmark '+cls+'">'+mk+'</span><span class="gl"><b>'+esc(c.l)+'</b> — '+esc(c.h)+'</span></div>';
  });
  h += '</div></div>';

  h += '<div class="fact"><h4>What it actually searches</h4><p>'+esc(t.corpus)+'</p></div>';
  h += '<div class="fact"><h4>Result ceiling</h4><p>'+esc(t.cap)+'</p></div>';
  h += '<div class="fact"><h4>Published evidence</h4><ul class="evlist">';
  t.ev.forEach(function(e){ h += '<li>'+esc(e)+'</li>'; });
  h += '</ul></div>';

  DIMS.forEach(function(d){
    var ds = dimScore(v,d);
    var open = !state.collapsed[d.id];
    h += '<div class="dim'+(open?"":" collapsed")+'" data-d="'+d.id+'">';
    h += '<div class="dhead" tabindex="0" role="button"><span class="di">'+d.id+'</span><h4>'+d.name+'</h4>';
    h += '<span class="dsc" style="color:'+(ds===null?"var(--ink-3)":col(ds))+'">'+(ds===null?"n/a":ds+"%")+'</span><span class="chev">▼</span></div>';
    h += '<div class="dbody">';
    CRIT.forEach(function(c){
      if(c.i < d.from[0] || c.i >= d.from[1]) return;
      h += '<div class="crit"><div class="cq"><div>';
      c.tags.forEach(function(tg){ h += '<span class="ctag">'+esc(tg)+'</span>'; });
      if(c.gate) h += '<span class="ctag gate">HARD GATE</span>';
      h += '</div><div class="cl">'+esc(c.l)+'</div><div class="ch">'+esc(c.h)+'</div></div>';
      h += '<div class="pick4" data-i="'+c.i+'">';
      VALS.forEach(function(pair){
        h += '<button type="button" data-v="'+pair[0]+'"'+(v[c.i]===pair[0]?' data-on="1"':'')+'>'+pair[1]+'</button>';
      });
      h += '</div></div>';
    });
    h += '</div></div>';
  });
  p.innerHTML = h;

  p.querySelectorAll(".dhead").forEach(function(dh){
    var fn = function(){
      var id = dh.parentNode.dataset.d;
      state.collapsed[id] = !state.collapsed[id];
      dh.parentNode.classList.toggle("collapsed"); save();
    };
    dh.addEventListener("click", fn);
    dh.addEventListener("keydown", function(e){ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); fn(); } });
  });
  p.querySelectorAll(".pick4").forEach(function(g){
    g.querySelectorAll("button").forEach(function(b){
      b.addEventListener("click", function(){
        setVal(state.cur, +g.dataset.i, +b.dataset.v);
        render();
      });
    });
  });

  var rh = '<div class="railsec"><h4>Fitness score</h4>';
  rh += '<div class="bigscore" style="color:'+col(s.pct)+'">'+s.pct+'<span style="font-size:20px;color:var(--ink-3)"> / 100</span></div>';
  rh += '<div class="track"><div class="fill '+fillC(s.pct)+'" style="width:'+s.pct+'%"></div></div>';
  rh += '<div class="bigsub">Weighted across '+(CRIT.length - s.na)+' applicable criteria. '+s.na+' are not applicable to this kind of tool and are excluded.</div>';
  if(s.unk) rh += '<div class="unk" style="margin-top:9px"><b>'+s.unk+(s.unk===1?' criterion is':' criteria are')+' undocumented</b> and score'+(s.unk===1?'s':'')+' as zero. Cochrane’s CESAR criteria direct you to reject tools whose capabilities cannot be verified, so this is the conservative reading, not a penalty.</div>';
  var onBench0 = state.bench.indexOf(state.cur)>=0;
  rh += '<button class="btn'+(onBench0?"":" on")+'" id="rail-bench" style="width:100%;margin-top:14px">'+(onBench0?"On the bench — remove":"Add to comparison")+'</button>';
  rh += '</div>';

  rh += '<div class="railsec"><h4>By dimension</h4><div class="dimbar">';
  DIMS.forEach(function(d){
    var ds = dimScore(v,d);
    rh += '<div class="dbrow"><span class="dbn">'+d.name+'</span><span class="dbv" style="color:'+(ds===null?"var(--ink-3)":col(ds))+'">'+(ds===null?"n/a":ds+"%")+'</span>';
    rh += '<span class="dbtrack"><span class="fill '+(ds===null?"":fillC(ds))+'" style="display:block;height:100%;width:'+(ds===null?0:ds)+'%"></span></span></div>';
  });
  rh += '</div></div>';

  rh += '<div class="railsec"><h4>Defensible uses</h4><div style="font-size:12.5px;line-height:1.55;color:var(--ink-2)">';
  var prim = STAGES.filter(function(x){return fit[x.k]==="primary";}).map(function(x){return x.n.replace("&amp;","and");});
  var assi = STAGES.filter(function(x){return fit[x.k]==="assistive";}).map(function(x){return x.n.replace("&amp;","and");});
  rh += prim.length ? '<b style="color:var(--good)">Can carry:</b> '+prim.join(", ")+'.<br>' : '<b style="color:var(--bad)">Carries no stage on its own.</b><br>';
  rh += assi.length ? '<span style="display:inline-block;margin-top:6px"><b style="color:var(--warn)">With human verification:</b> '+assi.join(", ")+'.</span>' : '';
  rh += '</div></div>';

  r.innerHTML = rh;
  document.getElementById("rail-bench").addEventListener("click", toggleBench);

  renderCompare(); renderDisclosure();
}

/* ---------- compare ---------- */
function toggleBench(){
  if(!state.cur) return;
  var i = state.bench.indexOf(state.cur);
  if(i>=0){ state.bench.splice(i,1); toast("Removed from the bench"); }
  else { state.bench.push(state.cur); toast("Added to the bench"); }
  save(); render();
}
function renderCompare(){
  var tbl = document.getElementById("cmp"), emp = document.getElementById("cmp-empty"), best = document.getElementById("bestrow");
  var rows = state.bench.filter(function(k){return !!get(k);});
  emp.classList.toggle("hidden", rows.length>0);
  if(!rows.length){ tbl.innerHTML=""; best.innerHTML='<div class="bestbox"><div class="bl">Nothing on the bench</div><div class="bv">—</div><div class="bn">Assess tools and add them to compare stage fitness side by side.</div></div>'; return; }

  var data = rows.map(function(k){
    var v = vals(k);
    return {k:k, t:get(k), v:v, s:score(v), fit:stageFit(v)};
  }).sort(function(a,b){ return b.s.pct - a.s.pct; });

  var h = '<thead><tr><th>Tool</th><th style="text-align:right;padding-right:14px">Score</th>';
  STAGES.forEach(function(st){ h += '<th class="st">'+st.n+'</th>'; });
  h += '<th></th></tr></thead><tbody>';
  data.forEach(function(d){
    h += '<tr><td class="nm">'+esc(d.t.name)+'<small>'+esc(role(d.fit,d.v).t)+'</small></td>';
    h += '<td class="sc" style="text-align:right;padding-right:14px;color:'+col(d.s.pct)+'">'+d.s.pct+'</td>';
    STAGES.forEach(function(st){
      var f = d.fit[st.k];
      h += '<td class="st"><span class="chip c-'+f+'">'+fitLabel(f).toUpperCase()+'</span></td>';
    });
    h += '<td><button class="rmv" data-k="'+d.k+'" title="Remove">×</button></td></tr>';
  });
  h += '</tbody>';
  tbl.innerHTML = h;
  tbl.querySelectorAll(".rmv").forEach(function(b){
    b.addEventListener("click", function(){
      var i = state.bench.indexOf(b.dataset.k);
      if(i>=0) state.bench.splice(i,1);
      save(); render();
    });
  });

  var bh = "";
  STAGES.forEach(function(st){
    var prim = data.filter(function(d){return d.fit[st.k]==="primary";});
    var assi = data.filter(function(d){return d.fit[st.k]==="assistive";});
    var pick, note;
    if(prim.length){ pick = prim[0].t.name; note = "Can carry this stage" + (prim.length>1 ? "; "+(prim.length-1)+" other"+(prim.length>2?"s":"")+" also qualify." : "."); }
    else if(assi.length){ pick = assi[0].t.name; note = "Assistive only — human verification required, and it must be reported as AI-assisted."; }
    else if(data.every(function(d){return d.fit[st.k]==="na";})){ pick = "Not applicable"; note = "No tool on the bench operates at this stage."; }
    else { pick = "None on the bench"; note = "Nothing here is fit for this stage."; }
    bh += '<div class="bestbox"><div class="bl">'+st.n+'</div><div class="bv">'+esc(pick)+'</div><div class="bn">'+esc(note)+'</div></div>';
  });
  best.innerHTML = bh;
}

/* ---------- disclosure ---------- */
function renderDisclosure(){
  var out = document.getElementById("d-out");
  var rows = state.bench.filter(function(k){return !!get(k);});
  var rv = state.disc.review || "this systematic review";
  var dt = state.disc.dates || "[dates of use]";
  if(!rows.length){
    out.textContent = "Add tools to the bench on the Compare tab and this paragraph builds itself from their assessed roles.";
    return;
  }
  var lines = [];
  lines.push("Use of artificial intelligence and automation");
  lines.push("");
  lines.push("In conducting " + rv + " we used the following tools between " + dt + ". The authors remain solely responsible for every methodological judgement made in this review; no tool made a final inclusion, exclusion, extraction, or appraisal decision without human verification.");
  lines.push("");
  rows.forEach(function(k){
    var t = get(k), v = vals(k), fit = stageFit(v), s = score(v);
    var prim = STAGES.filter(function(x){return fit[x.k]==="primary";}).map(function(x){return x.n.replace("&amp;","and").toLowerCase();});
    var assi = STAGES.filter(function(x){return fit[x.k]==="assistive";}).map(function(x){return x.n.replace("&amp;","and").toLowerCase();});
    var l = "• " + t.name + (t.url ? " (" + t.url + ")" : "") + ", version and access date to be recorded at point of use. ";
    if(prim.length) l += "Used as a primary tool for " + prim.join(", ") + ". ";
    if(assi.length) l += "Used in an assistive capacity only for " + assi.join(", ") + ", with all outputs verified by a human reviewer. ";
    if(!prim.length && !assi.length) l += "Assessed and not used. ";
    if(v[21] < 1) l += "No independent peer-reviewed evaluation of this tool's accuracy was available at the time of use; its outputs were therefore treated as provisional and verified in full. ";
    if(v[7] < 1) l += "Its results are not reproducible on re-running, so the retrieved set was exported and archived on the date of the search. ";
    lines.push(l.trim());
  });
  lines.push("");
  lines.push("Reported in accordance with PRISMA-trAIce (JMIR AI 2025;1:e80247) and the 2025 joint position statement of Cochrane, the Campbell Collaboration, JBI and the Collaboration for Environmental Evidence on the responsible use of AI in evidence synthesis. The authors declare no financial interest in any tool named above.");
  out.textContent = lines.join("\n");
}

/* ---------- wiring ---------- */
function setTab(w){
  ["assess","compare","disclose"].forEach(function(x){
    document.getElementById("tab-"+x).setAttribute("aria-selected", x===w ? "true":"false");
    document.getElementById("v-"+x).classList.toggle("hidden", x!==w);
  });
  var rw = document.getElementById("v-refs-wrap");
  if(rw) rw.classList.toggle("hidden", w!=="assess");
  window.scrollTo({top:0,behavior:"instant"});
}
document.getElementById("tab-assess").addEventListener("click",function(){setTab("assess");});
document.getElementById("tab-compare").addEventListener("click",function(){setTab("compare");});
document.getElementById("tab-disclose").addEventListener("click",function(){setTab("disclose");});
document.getElementById("btn-goto-cmp").addEventListener("click", function(){ setTab("compare"); });

function doAssess(){
  var q = document.getElementById("tool-input").value;
  if(!q.trim()) return;
  var k = resolve(q);
  if(k){ state.cur = k; save(); render(); toast("Loaded the reference profile for "+get(k).name); }
  else { createCustom(q.trim()); render(); toast("New entry created — score it against the criteria below"); }
  document.getElementById("tool-input").value = "";
  setTab("assess");
}
document.getElementById("btn-assess").addEventListener("click", doAssess);
document.getElementById("tool-input").addEventListener("keydown", function(e){ if(e.key==="Enter") doAssess(); });

["review","dates"].forEach(function(f){
  var el = document.getElementById("d-"+f);
  el.value = state.disc[f]||"";
  el.addEventListener("input", function(){ state.disc[f]=el.value; save(); renderDisclosure(); });
});
document.getElementById("btn-copy-disc").addEventListener("click", function(){
  var txt = document.getElementById("d-out").textContent;
  navigator.clipboard.writeText(txt).then(function(){ toast("Disclosure copied"); }, function(){ toast("Select the text and copy it manually"); });
});

document.getElementById("foot").innerHTML =
  'Criteria derive from <b>PRISMA 2020</b> (Page et al., <i>BMJ</i> 2021;372:n71), <b>AMSTAR 2</b> (Shea et al., <i>BMJ</i> 2017;358:j4008), <b>ROBIS</b> (Whiting et al., 2016), the 2025 joint position statement of Cochrane, Campbell, JBI and the Collaboration for Environmental Evidence (<i>Cochrane Database Syst Rev</i> ED000178; doi:10.1002/cl2.70074), the <b>RAISE</b> recommendations (2025), Cochrane’s <b>CESAR</b> operational thresholds, and <b>PRISMA-trAIce</b> (<i>JMIR AI</i> 2025;1:e80247). Process framing follows the <b>DISCAR</b> model (West &amp; Martin, 2023) as applied by Fromm, Martin, Gezer &amp; Ifenthaler (<i>Technol Knowl Learn</i> 2025;30:1–28), whose interviewees put current AI adoption in educational evidence synthesis at just <b>3.7–12.1%</b> and insisted the review process cannot be fully automated. Open-science base rates from Färnqvist et al. (<i>Cochrane Evid Synth Methods</i> 2026): of 300 systematic reviews, <b>70%</b> reported a registered protocol, <b>24%</b> shared data, <b>1%</b> shared code.<br><br>' +
  '<b>These are reference profiles, not certifications.</b> Every one is dated, and these tools change monthly — Cochrane’s own platform study reports late 2026 and will move the ground. Verify anything you intend to cite, edit any criterion you can evidence differently, and treat the score as a structured argument rather than a verdict. Companion to <i>The Review Auditor</i>.';


/* ---------- standards reference ---------- */
var STANDARDS = [
 {id:"prisma", short:"PRISMA 2020", kind:"Reporting checklist · 27 items",
  title:"PRISMA 2020 — Preferred Reporting Items for Systematic Reviews and Meta-Analyses",
  body:"Page MJ, McKenzie JE, Bossuyt PM, et al. <i>BMJ</i> 2021;372:n71. The reporting standard almost every journal now expects. It governs what a review must <b>state</b>, not how well it was done — but several of its items are the only place a methodological failure becomes visible. <b>Item 7</b> is the one that decides most of this page: it requires the full search strategy for every database, verbatim, including filters and limits. An AI search that cannot produce that string cannot be reported, whatever its recall. <b>Item 6</b> requires every source named and date-stamped; <b>item 8</b> requires the number of screeners and whether they worked independently; <b>item 16b</b> requires the full-text exclusions with a reason for each; <b>item 27</b> requires you to say what data, code and forms are publicly available."},
 {id:"amstar", short:"AMSTAR 2", kind:"Appraisal instrument · 7 critical domains",
  title:"AMSTAR 2 — A MeaSurement Tool to Assess systematic Reviews",
  body:"Shea BJ, Reeves BC, Wells G, et al. <i>BMJ</i> 2017;358:j4008. Sixteen items, of which <b>seven are critical domains</b>: protocol registration, search adequacy, justified exclusions, risk-of-bias assessment, meta-analytic methods, bias carried into interpretation, and publication bias. Its rating algorithm is unusual and worth understanding — <b>one critical flaw caps confidence at “low”; two caps it at “critically low”</b>, no matter how well the review performs elsewhere. That non-compensatory logic is why this suite reports hard gates separately from the score. AMSTAR 2 was built for reviews of health interventions, and education and social-science reviews fail it at very high rates on registration and formal appraisal tooling."},
 {id:"robis", short:"ROBIS", kind:"Bias assessment · 4 domains",
  title:"ROBIS — Risk of Bias in Systematic Reviews",
  body:"Whiting P, Savović J, Higgins JPT, et al. <i>J Clin Epidemiol</i> 2016;69:225–34. Where AMSTAR asks whether the review was <i>done well</i>, ROBIS asks whether its findings are likely to be <i>biased</i> — a different question with a different answer. Four domains carry signalling questions: eligibility criteria, identification and selection of studies, data collection and study appraisal, and synthesis and findings. A third phase then asks whether the review's own conclusions addressed the concerns those domains raised. It is deliberately reverse-scored relative to AMSTAR, and it supplies the criteria on this page about minimising error in screening and extraction."},
 {id:"joint", short:"Cochrane joint position statement", kind:"Governing policy · 2025 · six principles",
  title:"Cochrane, Campbell, JBI and the Collaboration for Environmental Evidence — joint position statement on AI in evidence synthesis",
  body:"Flemyng E, Noel-Storr A, Macura B, et al. (2025), published simultaneously in <i>Cochrane Database Syst Rev</i> ED000178, <i>Campbell Systematic Reviews</i> (doi:10.1002/cl2.70074) and <i>Environmental Evidence</i> 14:20. The single most authoritative statement on this question, and the source of two rules this page enforces. First: <b>“Evidence synthesists are ultimately responsible for their evidence synthesis, including the decision to use AI”</b> — which is why the scope and synthesis stages here are capped at Assistive and can never read Primary. Second: <b>“Any use of AI or automation that makes or suggests judgements should be fully and transparently reported”</b>, with system names, versions, dates, stages affected, validation evidence, limitations and financial interests. On screening it is specific: single-reviewer abstract screening carries an estimated <b>13% risk of falsely excluding a relevant study</b>, and AI may reduce that as a <i>second</i> reviewer — supplementary, never substitutive."},
 {id:"raise", short:"RAISE", kind:"Practice recommendations · 2025 · three parts",
  title:"RAISE — Responsible use of AI in evidence SynthEsis",
  body:"Released June 2025 in three parts on OSF: recommendations for practice; guidance for building and evaluating AI evidence-synthesis tools; and guidance for selecting and using them. Endorsed by the joint position statement. RAISE 3 is the part that maps most directly onto this page — it is a framework for choosing a tool rather than for using one, and it is where the questions about audit trails, data-use terms, and reportable model versions in dimension 7 originate."},
 {id:"cesar", short:"Cochrane CESAR thresholds", kind:"Operational numbers · the only ones published",
  title:"Cochrane CESAR — deciding when not to use an AI tool",
  body:"The most concrete figures any evidence-synthesis body has put in writing, and the basis for two criteria here. <b>Do not proceed if screening sensitivity is below 80%.</b> <b>Do not proceed if data-extraction sensitivity is below 92%.</b> All large language model and generative AI tools currently require human verification or internal validation — none is “acceptable for use” without additional safeguards. CESAR also gives four grounds for rejecting a tool outright: no published validation in a relevant context; performance claims resting only on developer studies; terms permitting content reuse for model training without opt-out; and unresponsive or opaque developers. That last ground is why undocumented criteria score as zero on this page rather than being set aside."},
 {id:"traice", short:"PRISMA-trAIce", kind:"Reporting extension · 2025",
  title:"PRISMA-trAIce — transparent reporting of AI use in conducting systematic reviews",
  body:"<i>JMIR AI</i> 2025;1:e80247. The reporting extension for AI use in the conduct of a review, and the template behind the Disclosure tab. Note the distinction, which is widely confused: <b>PRISMA-AI</b> (Cacciamani et al., <i>Nature Medicine</i> 2023) is for reporting systematic reviews <i>about</i> AI in healthcare. PRISMA-trAIce is for reporting your use of AI <i>to conduct</i> a review. They are not interchangeable, and citing the wrong one signals you have not read either."},
 {id:"discar", short:"DISCAR", kind:"Process model · the stage matrix",
  title:"DISCAR — the process model behind the stage matrix",
  body:"West RE &amp; Martin F (2023), as applied by Fromm YM, Martin F, Gezer T &amp; Ifenthaler D, <i>Technology, Knowledge and Learning</i> 2025;30:1–28. Designing, including/excluding, screening, coding, analysing and reporting — the phases this page scores separately, because fitness is not a property of a tool but of a tool at a stage. Fromm et al.'s twelve experienced review researchers put current AI adoption in educational evidence synthesis at just <b>3.7–12.1%</b>, discussed only manual screening, and were direct about the limit: “It's not completely automated and I don't think that's going to happen in the near future… it's really important that there is that aspect of human synthesis.”"},
 {id:"openscience", short:"Open science base rates", kind:"Cohort study · 300 reviews",
  title:"What systematic reviews actually do — the base rates",
  body:"Färnqvist K, Karlsson P, Wachtmeister V, Vallance P &amp; Sinervo E, <i>Cochrane Evidence Synthesis and Methods</i> 2026. A cohort of 300 interventional systematic reviews indexed in 2024. Of those, <b>70%</b> reported a registered protocol, <b>61%</b> included a data availability statement, <b>24%</b> actually shared underlying data, <b>1%</b> shared analytic code, and <b>2%</b> were preprinted. Protocol registration has doubled since 2014 (RR 2.03). Code sharing has not moved. These are the numbers to hold in mind when a tool's score looks harsh: the published literature it is being measured against is not clearing these bars either."}
];

function renderRefs(){
  var el = document.getElementById("refs");
  if(!el) return;
  var h = "";
  STANDARDS.forEach(function(r){
    h += '<div class="ref" id="ref-'+r.id+'"><div class="rk">'+r.kind+'</div><h4>'+r.title+'</h4><p>'+r.body+'</p></div>';
  });
  el.innerHTML = h;
  var chips = document.getElementById("stds");
  if(!chips) return;
  chips.innerHTML = STANDARDS.map(function(r){
    return '<button class="std" data-r="'+r.id+'">'+r.short+'</button>';
  }).join("");
  chips.querySelectorAll(".std").forEach(function(b){
    b.addEventListener("click", function(){
      setTab("assess");
      var target = document.getElementById("ref-"+b.dataset.r);
      if(!target) return;
      target.scrollIntoView({behavior:"smooth", block:"start"});
      target.classList.add("flash");
      setTimeout(function(){ target.classList.remove("flash"); }, 1400);
    });
  });
}
renderRefs();

