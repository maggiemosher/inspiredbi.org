  h += '<span class="badge '+(t.tscore>=5?"b-good":t.tscore>=3?"b-warn":"b-bad")+'">'+t.tscore+' of 6 transparency</span>';
  if(t.open) h += '<span class="badge b-good">Open source · self-hostable</span>';
  if(t.ferpa===2) h += '<span class="badge b-good">First-party FERPA statement</span>';
  else if(t.ferpa===1) h += '<span class="badge b-neutral">FERPA by parent agreement</span>';
  else h += '<span class="badge b-warn">No FERPA position found</span>';
  if(t.incident) h += '<span class="badge b-bad">Policy event on record</span>';
  h += '</div></div>';

  h += '<div class="lights">';
  ["lOwn","lDest","lTrain"].forEach(function(f){
    var v = t[f];
    h += '<div class="light l'+v+'"><div class="ln">'+(f==="lOwn"?"Ownership":f==="lDest"?"Data destination":"Training use")+
         '</div><div class="lv">'+LIGHTLAB[f][v].split(" ").slice(1).join(" ").replace(/^./,function(c){return c.toUpperCase();})+'</div></div>';
  });
  h += '</div>';

  QS.forEach(function(q){
    h += '<div class="qa"><div class="qn">'+q.n+'</div><h4>'+q.t+'</h4><p>'+rich(t[q.f]||"Not recorded.")+'</p>';
    if(q.f==="training" && t.incident) h += '<div class="alert"><b>On the record.</b> '+rich(t.incident)+'</div>';
    h += '</div>';
  });
  el.innerHTML = h;
  el.scrollIntoView({behavior:"smooth", block:"start"});
}

function renderCustom(raw){
  cur = null; renderSuggest();
  var isUrl = /^https?:\/\//i.test(raw) || /\.[a-z]{2,}($|\/)/i.test(raw);
  var host = isUrl ? raw.replace(/^https?:\/\//i,"").replace(/^www\./i,"").split(/[\/?#]/)[0] : raw;
  var base = isUrl ? "https://"+host : "";
  var el = document.getElementById("profile");
  var h = '<div class="phead"><div class="pname">'+esc(host)+'</div>';
  h += '<div class="pentity">Not in the reference set — here is how to answer the four questions yourself.</div></div>';
  h += '<div class="custom"><h3>The five-minute provenance check</h3>';
  h += '<p style="font-size:13.5px;color:var(--ink-2);margin:8px 0 0;line-height:1.6;max-width:80ch">This page holds dated reference cards, not a live lookup — a static page cannot fetch a vendor\'s policy for you, and a card that silently went stale would be worse than none. What it can do is tell you exactly where to look. Every answer below comes from a fixed set of URLs that almost every vendor uses.</p>';
  h += '<ol>';
  h += '<li><b>Who made it.</b> Open <code>'+esc(base||"[site]")+'/about</code>, then the page footer for the legal entity and copyright holder — the footer is where acquisitions show up first. Cross-check the entity name on Crunchbase and on your national companies register. If the footer names a different company than the product, the tool has been acquired and the policy you are about to read may not have been updated.</li>';
  h += '<li><b>Why it was made.</b> The about page gives the mission; the <code>/pricing</code> page gives the truth. Free with no institutional tier and no visible revenue means you are not the customer. Grant-funded and university-run means the incentive to monetise your input is absent.</li>';
  h += '<li><b>Where your input goes.</b> Open <code>'+esc(base||"[site]")+'/privacy</code> and search the page for these words: <i>subprocessor</i>, <i>OpenAI</i>, <i>Anthropic</i>, <i>Azure</i>, <i>AWS</i>, <i>United States</i>, <i>transfer</i>. A vendor that names its model providers and its server region is telling you something real. One that says only "trusted third parties" is not.</li>';
  h += '<li><b>Whether it trains on you.</b> Search the same page for <i>train</i>. Three outcomes, and the third is the common one: an explicit "we do not train on your data"; an explicit opt-out (check whether it is <b>retroactive</b> — usually it is not); or <b>silence</b>. Silence is not a no. Ten of the twenty-eight tools carded here are silent.</li>';
  h += '<li><b>Then check the gaps.</b> <code>'+esc(base||"[site]")+'/terms</code> for the licence you grant over uploads; <code>trust.'+esc(host||"[site]")+'</code> or <code>'+esc(base||"[site]")+'/security</code> for SOC 2 and ISO 27001; and the word <i>retention</i> for how long any of this is kept. If the legal pages render only in JavaScript and cannot be read by a plain fetch, record that — four vendors in this set publish policies no automated compliance checker can read, and that is itself a finding.</li>';
  h += '</ol>';
  h += '<div class="alert" style="margin:18px 24px 0 0"><b>The one rule that survives every policy change:</b> do not put anything into a tool that you could not tolerate being retained, subpoenaed, or read by a human reviewer. Deletion promises have been suspended by litigation the vendor was not party to, and opt-outs are routinely non-retroactive.</div>';
  h += '</div>';
  el.innerHTML = h;
  el.scrollIntoView({behavior:"smooth", block:"start"});
}

function go(){
  var raw = document.getElementById("q").value.trim();
  if(!raw) return;
  var k = resolve(raw);
  if(k) show(k); else renderCustom(raw);
  document.getElementById("q").value = "";
}
document.getElementById("go").addEventListener("click", go);
document.getElementById("q").addEventListener("keydown", function(e){ if(e.key==="Enter") go(); });

/* ranking table */
(function(){
  var rows = Object.keys(P).map(function(k){ return {k:k, t:P[k]}; })
    .sort(function(a,b){ return b.t.tscore - a.t.tscore || a.t.name.localeCompare(b.t.name); });
  var h = '<thead><tr><th>Tool</th><th class="c">Ownership</th><th class="c">Destination</th><th class="c">Training use</th><th>Notes</th></tr></thead><tbody>';
  var L = ["Undisclosed","Partial","Stated"];
  rows.forEach(function(r){
    var t = r.t;
    h += '<tr><td class="n"><a href="#" data-k="'+r.k+'" style="text-decoration:none;color:inherit">'+esc(t.name)+'</a></td>';
    ["lOwn","lDest","lTrain"].forEach(function(f){
      h += '<td class="c"><span class="mini m'+t[f]+'">'+L[t[f]].toUpperCase()+'</span></td>';
    });
    var notes = [];
    if(t.open) notes.push("open source");
    if(t.ferpa===2) notes.push("FERPA stated");
    if(t.incident) notes.push("policy event on record");
    h += '<td style="color:var(--ink-3);font-size:12px">'+(notes.join(" · ")||"—")+'</td></tr>';
  });
  h += '</tbody>';
  var tbl = document.getElementById("rank");
  tbl.innerHTML = h;
  tbl.querySelectorAll("a[data-k]").forEach(function(a){
    a.addEventListener("click", function(e){ e.preventDefault(); show(a.dataset.k); });
  });
})();

