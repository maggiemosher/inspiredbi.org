  w.innerHTML = h;
  w.querySelectorAll(".pill").forEach(function(b){
    b.addEventListener("click", function(){ show(b.dataset.k); });
  });
}

function resolve(raw){
  var q = raw.trim().toLowerCase();
  if(!q) return null;
  var host = q.replace(/^https?:\/\//,"").replace(/^www\./,"").split(/[\/?#]/)[0];
  var keys = Object.keys(P);
  for(var i=0;i<keys.length;i++){
    var th = (P[keys[i]].url||"").replace(/^https?:\/\//,"").replace(/^www\./,"").split(/[\/?#]/)[0];
    if(host && th && (host===th || th.indexOf(host)===0 || host.indexOf(th)===0)) return keys[i];
  }
  for(var j=0;j<keys.length;j++){
    if(P[keys[j]].name.toLowerCase()===q || keys[j]===q.replace(/[^a-z0-9]/g,"")) return keys[j];
  }
  for(var p=0;p<keys.length;p++){
    if(P[keys[p]].name.toLowerCase().indexOf(q)>=0 || (P[keys[p]].entity||"").toLowerCase().indexOf(q)>=0) return keys[p];
  }
  return null;
}

