function rich(s){
  var h = esc(s);
  h = h.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, function(m,t,u){
    return '<a href="'+u+'" target="_blank" rel="noopener">'+t+'</a>';
