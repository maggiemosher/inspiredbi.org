// --- Service (Professional / Public / University): split each CV line into Start/End/Role/Org/Location/Description.
function fiExtractLocation(text){
  var m = text.match(/\b([A-Za-z][a-zA-Z]+(?:\s[A-Za-z]+)?),\s*(KS|MO|OH|NM|PA|AZ|MD|UT|FL|WV|IL|TX|CA|NY)\b/);
  if(m) return m[1] + ", " + m[2];
  var m2 = text.match(/\b(KS|MO|OH|NM|PA|AZ|MD|UT|FL|WV|IL|TX|CA|NY)\b/);
  if(m2) return "State of " + m2[1];
  return "[Not stated in CV — please verify]";
}
function fiSplitRoleOrg(rest){
  var m = rest.match(/^([A-Z][^,]*?)\s+(providing|aiding|creating|founding|organizing|coaching|instructing|teaching|managing|training|collaborating|assisting|writing|working|fundraising)\b/);
  if(m) return {role: m[1].trim(), org: rest.trim()};
  var m2 = rest.match(/^([^,]{3,60}),\s*(.+)$/);
  if(m2) return {role: m2[1].trim(), org: m2[2].trim()};
  var words = rest.split(/\s+/);
  return {role: words.slice(0, Math.min(8, words.length)).join(" ").replace(/[.,]$/,""), org: rest};
}
function fiParseServiceEntry(e, opts){
  opts = opts || {};
  var t = (e.title||"").trim();
  var start = "", end = "", rest = t;
  var m = t.match(/^([A-Za-z]+\.?\s*\d{4})\s*-\s*(Current|Present|[A-Za-z]+\.?\s*\d{4})/);
  if(m){ start = m[1]; end = /current|present/i.test(m[2]) ? "Present" : m[2]; rest = t.slice(m[0].length).replace(/^[,\s]+/,""); }
  else {
    m = t.match(/\((?:[A-Za-z]+,\s*)?(\d{4})\s*-\s*(\d{4})\)\s*$/);
    if(m){ start = m[1]; end = m[2]; rest = t.slice(0, t.length - m[0].length).trim(); }
    else {
      m = t.match(/^(\d{4})\s*-\s*(present|\d{4})/i);
      if(m){ start = m[1]; end = /present/i.test(m[2]) ? "Present" : m[2]; rest = t.slice(m[0].length).replace(/^[,\s]+/,""); }
      else {
        m = t.match(/^([A-Za-z]+\.?\s*\d{4})\b/);
        if(m){ start = m[1]; end = "[Not stated in CV — please add]"; rest = t.slice(m[0].length).replace(/^[,\s]+/,""); }
      }
    }
  }
  var role, org;
  if(opts.org){ role = rest; org = opts.org; }
  else { var split = fiSplitRoleOrg(rest); role = split.role; org = split.org; }
  var location = opts.location || fiExtractLocation(t);
  return {
    start: start || "[Not stated in CV — please add]",
    end: end || "[Not stated in CV — please add]",
    role: role || rest,
    org: org || rest,
    location: location,
    description: t
  };
}
function fiServiceBlock(e, opts){
  var p = fiParseServiceEntry(e, opts);
  return [
    "Start Date: " + p.start,
    "End Date: " + p.end,
    "Position/Role: " + p.role,
    "Organization/Publication/Activity: " + p.org,
    "Location (City, State/Country): " + p.location,
    "Description: " + p.description
  ].join("\n");
}

// --- Courses Taught Summary: one row per course code, combining every section/year in the CV.
var FI_KNOWN_ORGS = ["University of Kansas", "Baker University", "Johns Hopkins University"];
function fiCourseOrg(group){
  var g = group || "";
  for(var i=0;i<FI_KNOWN_ORGS.length;i++){ if(g.indexOf(FI_KNOWN_ORGS[i]) > -1) return FI_KNOWN_ORGS[i]; }
  var cut = g.split(/\s+(Professor|Adjunct|Course)/)[0].trim();
  return cut || "[Not stated in CV — please add]";
}
function fiCourseFullTitle(title){
  var m = (title||"").match(/^(.*?)\s*\([^)]*\d{4}[^)]*\)/);
  return (m ? m[1] : (title||"")).replace(/[†‡]/g,"").trim();
}
function fiCourseYears(title){
  // years only from the first parenthetical that contains one (the term/session note) — a course
  // CODE like "EDU 5323" can itself contain a 4-digit number, which must not be read as a year.
  var m = (title||"").match(/\(([^)]*\d{4}[^)]*)\)/);
  if(!m) return {start:null, end:null};
  var years = (m[1].match(/\d{4}/g) || []).map(Number);
  if(!years.length) return {start:null, end:null};
  return {start: Math.min.apply(null, years), end: Math.max.apply(null, years)};
}

// --- Student Mentoring: named students + every co-author found in Publications/Presentations.
function fiExtractCoauthors(){
  var re = /([A-Z][a-zA-Z\-]+),\s*([A-Z]\.(?:\s*[A-Z]\.)?)/g;
  var counts = {};
  fiEntriesFor("publication").concat(fiEntriesFor("presentation")).forEach(function(e){
    var t = e.title || "", m;
    re.lastIndex = 0;
    while((m = re.exec(t))){
      if(/^Mosher/i.test(m[1])) continue;
      var name = m[1] + ", " + m[2];
      counts[name] = (counts[name]||0) + 1;
    }
  });
  return Object.keys(counts).sort(function(a,b){ return counts[b]-counts[a]; });
}

// --- Section/subsection tree. Each `gen` returns {lines:[...]} or {note:"..."} for an empty/synced block.
function buildFISections(){
  var pubs = fiEntriesFor("publication");
  var grants = fiEntriesFor("grant");
  var svcScholarly = fiEntriesFor("service_scholarly");

  var byPub = {journal_articles:[], book_chapters:[], conference_proceedings:[], other_publications:[], educational_materials:[]};
  pubs.forEach(function(e){ (byPub[fiClassifyPublication(e)] = byPub[fiClassifyPublication(e)]||[]).push(e); });

  var byGrant = {grants_funded:[], grants_proposal:[]};
  grants.forEach(function(e){ byGrant[fiClassifyGrant(e)].push(e); });

  var bySvc = {professional_membership:[], professional_service:[]};
  svcScholarly.forEach(function(e){ bySvc[fiClassifyServiceScholarly(e)].push(e); });

  function sortYr(arr){ return arr.slice().sort(function(a,b){ return (b.year||0)-(a.year||0); }); }
  function linesOf(arr){ return sortYr(arr).map(fiLine); }

  return [
    {key:"career", label:"Career", subs:[
      {key:"degrees", label:"Degrees", warn:"Terminal Degree in Discipline and Highest Degree Earned are best-guessed by comparing your degrees (Doctorate > Master's > Bachelor's) — please verify against Faculty Insight's dropdowns.", gen:function(){
        var rows = sortYr(fiEntriesFor("education"));
        if(!rows.length) return {note:fiEmpty("Degrees")};
        var parsed = rows.map(fiParseDegree);
        var maxRank = Math.max.apply(null, parsed.map(function(p){ return fiDegreeRank(p.degree); }));
        var blocks = rows.map(function(e,i){
          var p = parsed[i];
          var isHighest = fiDegreeRank(p.degree) === maxRank;
          return [
            "Degree: " + p.degree,
            "Awarded Date: " + p.year,
            "Institution: " + p.institution,
            "Major: " + (p.major || "[Not stated in CV — please add]"),
            "Terminal Degree in Discipline: " + (isHighest ? "Yes" : "No") + " [Best guess — please verify]",
            "Highest Degree Earned: " + (isHighest ? "Yes" : "No") + " [Best guess — please verify]"
          ].join("\n");
        });
        return {lines: blocks, blockSep:true};
      }},
      {key:"licenses", label:"Licenses & Certifications", gen:function(){ var l=linesOf(fiEntriesFor("certification")); return l.length?{lines:l}:{note:fiEmpty("Licenses & Certifications")}; }},
      {key:"prof_dev", label:"Professional Development", warn:"These are the conference/event names pulled from your Presentations — add the specific PD session or credential title for each; the venue is a starting point, not the final entry.", gen:function(){
        var venues = {};
        fiEntriesFor("presentation").forEach(function(e){
          var v = fiExtractVenue(e.title);
          if(v && v.length > 3 && v.length < 140) venues[v] = true;
        });
        var names = Object.keys(venues).sort();
        if(!names.length) return {note:fiEmpty("Professional Development")};
        var lines = names.map(function(v){ return "Conference/Venue: " + v + "\nTitle of PD: [Add the specific session/credential title you completed]"; });
        return {lines:lines, blockSep:true};
      }},
      {key:"prof_exp", label:"Professional Experience", gen:function(){
        var rows = sortYr(fiEntriesFor("position"));
        if(!rows.length) return {note:fiEmpty("Professional Experience")};
        var lines = rows.map(function(e){
          var ct = fiConsultingType(e);
          return fiLine(e) + (ct ? "\nType of Consulting: " + ct + " [Best guess — please verify]" : "");
        });
        return {lines:lines, blockSep:true};
      }},
      {key:"prof_membership", label:"Professional Membership", warn:"Scope/Impact is best-guessed from each organization's own name (e.g. \"National\" → National/Federal, \"International\" → International); set to Unknown where I couldn't tell.", gen:function(){
        var rows = sortYr(bySvc.professional_membership);
        if(!rows.length) return {note:fiEmpty("Professional Membership")};
        var blocks = rows.map(function(e){
          var org = fiMembershipOrg(e.title);
          var d = fiMembershipDates(e.title);
          return [
            "Organization: " + org,
            "Start Date: " + (d.start || "[Not stated — please add]"),
            "End Date: " + (d.end || "[Not stated — please add]"),
            "Scope/Impact: " + fiMembershipScope(org) + " [Best guess — please verify, or change to Unknown]"
          ].join("\n");
        });
        return {lines: blocks, blockSep:true};
      }},
      {key:"refs_interviews", label:"References to My Work-Interviews", warn:"I tried to pull \"cited by\" data from ResearchGate for you, but ResearchGate's site blocked the automated request (a rate-limit error, on the exact link you gave me and again on a search). I wasn't able to retrieve a reliable citation list this way, and I didn't want to guess at citations for an official workload report. ResearchGate shows a Citations tab on each of your publication pages when you're logged in — that's the accurate source. Please check that tab per publication and paste anything relevant here.", gen:function(){
        return {note:"[Not retrievable via automated ResearchGate access — see the note above. Check the \"Cited by\"/Citations tab on each publication's ResearchGate page yourself and paste interview references here.]"};
      }}
    ]},
    {key:"creative", label:"Creative Works", subs:[
      {key:"exhibits", label:"Exhibits & Installations", gen:function(){ return {note:fiEmpty("Exhibits & Installations")}; }},
      {key:"literary", label:"Literary & Critical Works", gen:function(){ return {note:fiEmpty("Literary & Critical Works")}; }},
      {key:"other_creative", label:"Other Creative Works", gen:function(){ return {note:fiEmpty("Other Creative Works")}; }},
      {key:"performances", label:"Performances", gen:function(){ return {note:fiEmpty("Performances")}; }},
      {key:"productions", label:"Productions", gen:function(){ return {note:fiEmpty("Productions")}; }}
    ]},
    {key:"scholarship", label:"Scholarship", subs:[
      {key:"book_chapters", label:"Book Chapters", gen:function(){ var l=linesOf(byPub.book_chapters); return l.length?{lines:l}:{note:fiEmpty("Book Chapters")}; }},
      {key:"books", label:"Books", gen:function(){ return {note:fiEmpty("Books")}; }},
      {key:"clinical_trials", label:"Clinical Trials", gen:function(){ return {note:fiEmpty("Clinical Trials")}; }},
      {key:"conf_proceedings", label:"Conference Proceedings", gen:function(){ var l=linesOf(byPub.conference_proceedings); return l.length?{lines:l}:{note:fiEmpty("Conference Proceedings")}; }},
      {key:"educational_materials", label:"Educational Materials", gen:function(){ var l=linesOf(byPub.educational_materials); return l.length?{lines:l}:{note:fiEmpty("Educational Materials")}; }},
      {key:"grants_funded", label:"Grants-Funded", warn:"Faculty Insight already lists funded-grant records here (auto-synced) — compare before pasting to avoid duplicates. Every field is filled from your CV; anything marked '[best guess]' or '[please add]' should be double-checked before you submit.", gen:function(){
        var rows = sortYr(byGrant.grants_funded);
        if(!rows.length) return {note:fiEmpty("Grants-Funded")};
        return {lines: rows.map(fiGrantBlock), blockSep:true};
      }},
      {key:"grants_proposal", label:"Grants-Proposal", warn:"Faculty Insight already lists proposal records here (auto-synced) — compare before pasting to avoid duplicates. Same best-guess/flag approach as Grants-Funded above.", gen:function(){
        var rows = sortYr(byGrant.grants_proposal);
        if(!rows.length) return {note:fiEmpty("Grants-Proposal")};
        return {lines: rows.map(fiGrantBlock), blockSep:true};
      }},
      {key:"journal_articles", label:"Journal Articles", warn:"Faculty Insight already lists records here, synced via Web of Science. Compare before pasting to avoid duplicates. Work Status is filled per entry — unpublished ones say to pick \"no release date\" for the first drop-down.", gen:function(){
        var rows = sortYr(byPub.journal_articles);
        if(!rows.length) return {note:fiEmpty("Journal Articles")};
        var lines = rows.map(function(e){
          var status = fiWorkStatus(e);
          var extra = "\nWork Status: " + status;
          if(status !== "Published") extra += "\nRelease Date: [Select \"no release date\" for the first drop-down since this is unpublished]";
          return fiLine(e) + extra;
        });
        return {lines:lines, blockSep:true};
      }},
      {key:"other_pubs", label:"Other Publications", gen:function(){
        var rows = sortYr(byPub.other_publications);
        if(!rows.length) return {note:fiEmpty("Other Publications")};
        var lines = rows.map(function(e){ return fiLine(e) + "\nWork Status: " + fiWorkStatus(e); });
        return {lines:lines, blockSep:true};
      }},
      {key:"patents", label:"Patents & Copyrights", gen:function(){ return {note:fiEmpty("Patents & Copyrights")}; }},
      {key:"presentations", label:"Presentations", gen:function(){ var l=linesOf(fiEntriesFor("presentation")); return l.length?{lines:l}:{note:fiEmpty("Presentations")}; }},
      {key:"reviews", label:"Reviews", warn:"Faculty Insight already auto-syncs some reviews via Web of Science/Springer Nature — compare before pasting to avoid duplicates. Built from your ORCID record's 31 reviews across 8 journals; Article Title is anonymized per journal peer-review policy, exactly as you described.", gen:function(){
        return {lines: fiReviewsBlocks(), blockSep:true};
      }},
      {key:"software", label:"Software & Digital Media", gen:function(){ var l=linesOf(fiEntriesFor("media")); return l.length?{lines:l}:{note:fiEmpty("Software & Digital Media")}; }}
    ]},
    {key:"service", label:"Service", subs:[
      {key:"prof_service", label:"Professional Service", warn:"Start/End dates, Position/Role, and Location are best-guess parses of free-text CV lines — please double check each before pasting.", gen:function(){
        var rows = sortYr(bySvc.professional_service);
        if(!rows.length) return {note:fiEmpty("Professional Service")};
        return {lines: rows.map(function(e){ return fiServiceBlock(e); }), blockSep:true};
      }},
      {key:"public_service", label:"Public Service", warn:"Start/End dates, Position/Role, and Location are best-guess parses of free-text CV lines — please double check each before pasting.", gen:function(){
        var rows = sortYr(fiEntriesFor("service_community"));
        if(!rows.length) return {note:fiEmpty("Public Service")};
        return {lines: rows.map(function(e){ return fiServiceBlock(e); }), blockSep:true};
      }},
      {key:"university_service", label:"University Service", warn:"Organization is set to University of Kansas and Location to Lawrence, KS for all of these — please verify Start/End dates before pasting.", gen:function(){
        var rows = sortYr(fiEntriesFor("service_university"));
        if(!rows.length) return {note:fiEmpty("University Service")};
        return {lines: rows.map(function(e){ return fiServiceBlock(e, {org:"University of Kansas", location:"Lawrence, KS"}); }), blockSep:true};
      }}
    ]},
    {key:"teaching", label:"Teaching & Mentoring", subs:[
      {key:"courses_taught", label:"Courses Taught", gen:function(){ var l=linesOf(fiEntriesFor("teaching")); return l.length?{lines:l}:{note:fiEmpty("Courses Taught")}; }},
      {key:"courses_summary", label:"Courses Taught Summary", warn:"One row per course code, combining every section/year found in your CV. Please verify organization names and date ranges before pasting.", gen:function(){
        var rows = fiEntriesFor("teaching");
        if(!rows.length) return {note:fiEmpty("Courses Taught Summary")};
        var byCode = {};
        rows.forEach(function(e){
          var code = fiCourseCode(e.title);
          var yrs = fiCourseYears(e.title);
          if(!byCode[code]) byCode[code] = {org: fiCourseOrg(e.group), full: fiCourseFullTitle(e.title), starts: [], ends: []};
          if(yrs.start) byCode[code].starts.push(yrs.start);
          if(yrs.end) byCode[code].ends.push(yrs.end);
        });
        var blocks = Object.keys(byCode).sort().map(function(code){
          var c = byCode[code];
          var start = c.starts.length ? Math.min.apply(null, c.starts) : "[Not stated — please add]";
          var end = c.ends.length ? Math.max.apply(null, c.ends) : "[Not stated — please add]";
          return [
            "Start Date: " + start,
            "End Date: " + end,
            "Name of Organization: " + c.org,
            "Course or List of Courses: " + code + " — " + c.full
          ].join("\n");
        });
        return {lines: blocks, blockSep:true};
      }},
      {key:"directed_learning", label:"Directed Student Learning", gen:function(){ return {note:fiEmpty("Directed Student Learning (e.g., dissertation/thesis committees)")}; }},
      {key:"student_achievements", label:"Student Achievements", warn:"I didn't research or add anything beyond what you told me — see the note above.", gen:function(){
        var l = linesOf(fiEntriesFor("student_achievement"));
        return l.length ? {lines:l} : {note:fiEmpty("Student Achievements")};
      }},
      {key:"student_mentoring", label:"Student Mentoring", warn:"This combines the students you named directly with every co-author name found in your Publications and Presentations, most-frequent first, exactly as you asked. Some of these names are almost certainly colleagues, not mentees (e.g., long-time research partners you've published with many times) — please delete any name that isn't actually a student/mentee before pasting. Mentoring Activity, Program/Major, and Year are left blank for you to fill in.", gen:function(){
        var named = linesOf(fiEntriesFor("student_mentoring"));
        var coauthors = fiExtractCoauthors().map(function(n){ return n + " — Mentoring Activity: [add] | Program/Major: [add] | Year: [add]"; });
        var lines = named.concat(coauthors);
        return lines.length ? {lines:lines} : {note:fiEmpty("Student Mentoring")};
      }}
    ]},
    {key:"awards", label:"Awards & Honors", subs:[
      {key:"awards_all", label:"Each award, broken into Faculty Insight's 7 fields", gen:function(){
        var rows = sortYr(fiEntriesFor("award"));
        if(!rows.length) return {note:fiEmpty("Awards & Honors")};
        return {lines: rows.map(fiAwardBlock), blockSep:true};
      }}
    ]}
  ];
}

function fiSubsectionText(sub){
  var out = sub.gen();
  if(out.note) return out.note;
  return out.lines.join(out.blockSep ? "\n\n" : "\n\n");
}
function fiSectionText(section){
  var parts = [section.label.toUpperCase(), "=".repeat(section.label.length)];
  section.subs.forEach(function(sub){
    parts.push("\n" + sub.label);
    parts.push(fiSubsectionText(sub));
  });
  return parts.join("\n");
}
function fiFullText(){
  return buildFISections().map(fiSectionText).join("\n\n\n");
}

function renderFIView(){
  if(state.entries.length === 0){
    $("#fi-sections").innerHTML = dataReady
      ? '<div class="panel"><h2>Nothing loaded yet</h2><div class="sub">' +
          'Your activity data didn\'t come through on this load — this is a loading hiccup, not lost data ' +
          '(everything you\'ve entered is safely stored). Try reloading this page. If it keeps happening, let me know.' +
        '</div><button class="btn primary" id="fi-retry-btn">Reload page</button></div>'
      : '<div class="panel"><h2>Loading your activity data…</h2><div class="sub">' +
          'This fills in automatically in a moment — no need to do anything.' +
        '</div></div>';
    var retryBtn = $("#fi-retry-btn");
    if(retryBtn) retryBtn.addEventListener("click", function(){ location.reload(); });
    if(!dataReady){
      // try again shortly in case this view was opened before the first sync arrived
      setTimeout(function(){ if(state.view === "fi") renderFIView(); }, 900);
    }
    return;
  }
  var sections = buildFISections();
  var html = sections.map(function(section){
    var subsHtml = section.subs.map(function(sub){
      var out = sub.gen();
      var count = out.lines ? out.lines.length : 0;
      var bodyText = out.note ? out.note : out.lines.join(out.blockSep ? "\n\n" : "\n\n");
      var isEmptyNote = !!out.note;
      return '<div class="fi-sub">' +
        '<div class="fi-sub-head">' +
          '<h3>' + esc(sub.label) + '</h3>' +
          (isEmptyNote ? '' : '<span class="fi-sub-count">' + count + ' item' + (count===1?'':'s') + '</span>') +
          '<button class="btn subtle" style="font-size:12px;padding:4px 9px;" data-fi-copy data-section="' + section.key + '" data-sub="' + sub.key + '">Copy</button>' +
        '</div>' +
        (sub.warn ? '<div class="fi-flag" style="font-size:12px;margin-bottom:6px;">⚠ ' + esc(sub.warn) + '</div>' : '') +
        '<div class="fi-pre' + (isEmptyNote ? ' empty' : '') + '">' + esc(bodyText) + '</div>' +
      '</div>';
    }).join("");
    return '<div class="panel fi-section-panel">' +
      '<div class="fi-section-head"><h2>' + esc(section.label) + '</h2>' +
        '<button class="btn" data-fi-copy-section="' + section.key + '">Copy this whole section</button>' +
      '</div>' +
      subsHtml +
    '</div>';
  }).join("");
  $("#fi-sections").innerHTML = html;

  $all("[data-fi-copy]", $("#fi-sections")).forEach(function(btn){
    btn.addEventListener("click", function(){
      var section = sections.find(function(s){ return s.key === btn.dataset.section; });
      var sub = section.subs.find(function(s){ return s.key === btn.dataset.sub; });
      copyText(fiSubsectionText(sub));
    });
  });
  $all("[data-fi-copy-section]", $("#fi-sections")).forEach(function(btn){
    btn.addEventListener("click", function(){
      var section = sections.find(function(s){ return s.key === btn.dataset.fiCopySection; });
      copyText(fiSectionText(section));
    });
  });
}

function copyText(text){
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(function(){ showToast("Copied — paste into Faculty Insight"); }).catch(function(){ legacyCopy(text); });
  } else legacyCopy(text);
}
function legacyCopy(text){
  var ta = document.createElement("textarea"); ta.value = text; ta.style.position="fixed"; ta.style.opacity="0";
  document.body.appendChild(ta); ta.select();
  try{ document.execCommand("copy"); showToast("Copied — paste into Faculty Insight"); }catch(e){ showToast("Couldn't copy — select manually"); }
  document.body.removeChild(ta);
}

/* ============== CV Builder ============== */
function buildCVMarkdown(){
  var p = state.profile || DEFAULT_PROFILE;
  var lines = [];
  lines.push("# " + p.name);
  lines.push("*" + p.role + " — " + p.org + "*");
  lines.push(p.contact);
  lines.push("");
  CATEGORIES.forEach(function(c){
    var rows = state.entries.filter(function(e){ return e.category === c.key; })
      .slice().sort(function(a,b){ return (b.year||0)-(a.year||0); });
    if(!rows.length) return;
    lines.push("## " + c.cv);
    var lastGroup = null;
    rows.forEach(function(e){
      if(e.group && e.group !== lastGroup){ lines.push("_" + e.group + "_"); lastGroup = e.group; }
      if(!e.group) lastGroup = null;
      lines.push("- **" + (e.year||"") + "** " + e.title + (e.status ? " (" + e.status + ")" : ""));
    });
    lines.push("");
  });
  return lines.join("\n");
}

function renderCVView(){
  var p = state.profile || DEFAULT_PROFILE;
  var html = "<h1>"+esc(p.name)+"</h1>" +
    "<div class='cv-role'>"+esc(p.role)+" — "+esc(p.org)+"</div>" +
    "<div class='cv-contact'>"+esc(p.contact)+"</div>";

  CATEGORIES.forEach(function(c){
    var rows = state.entries.filter(function(e){ return e.category === c.key; })
      .slice().sort(function(a,b){ return (b.year||0)-(a.year||0); });
    if(!rows.length) return;
    html += "<div class='cv-section'><h2>"+esc(c.cv)+"</h2>";
    var lastGroup = null;
    rows.forEach(function(e){
      if(e.group && e.group !== lastGroup){ html += "<div class='cv-group'>"+esc(e.group)+"</div>"; lastGroup = e.group; }
      if(!e.group) lastGroup = null;
      html += "<div class='cv-item'><span class='yr tabular'>"+(e.year||"")+"</span>"+esc(e.title)+(e.status?" <i>("+esc(e.status)+")</i>":"")+"</div>";
    });
    html += "</div>";
  });
  $("#cv-render").innerHTML = html;
}

/* ============== Entry modal ============== */
function openEntryModal(existing){
  var isEdit = !!existing;
  var veil = document.createElement("div");
  veil.className = "modal-veil";
  veil.innerHTML =
    '<div class="modal">' +
      '<h3>'+(isEdit ? "Edit activity" : "Add activity")+'</h3>' +
      '<div class="field-row">' +
        '<div class="field"><label>Category</label><select id="m-category">'+CATEGORIES.map(function(c){return '<option value="'+c.key+'">'+esc(c.label)+'</option>';}).join("")+'</select></div>' +
        '<div class="field" style="max-width:110px;"><label>Year</label><input type="number" id="m-year" placeholder="2026"></div>' +
      '</div>' +
      '<div class="field"><label>Description (as it should read on your CV)</label><textarea id="m-title" placeholder="e.g. Mosher, M. (2026, March). Title of presentation [Presentation]. Conference name, City, State."></textarea></div>' +
      '<div class="field"><label>Group / subsection (optional)</label><input type="text" id="m-group" placeholder="e.g. Peer Reviewed Publications"></div>' +
      '<div class="field-row">' +
        '<div class="field"><label>Status (optional — mainly for grants)</label><select id="m-status"><option value="">—</option><option>Funded</option><option>Not Funded</option><option>Under Review</option><option>In Progress</option><option>Completed</option></select></div>' +
      '</div>' +
      '<div class="field"><label>Private notes (not shown on generated CV)</label><input type="text" id="m-notes" placeholder="optional"></div>' +
      '<div class="field checkbox-field"><input type="checkbox" id="m-fi"><label style="margin:0;" for="m-fi">Already entered in KU Faculty Insight</label></div>' +
      '<div class="modal-actions">' +
        (isEdit ? '<button class="btn danger" id="m-delete">Delete</button>' : '<span></span>') +
        '<div class="right">' +
          '<button class="btn subtle" id="m-cancel">Cancel</button>' +
          '<button class="btn primary" id="m-save">'+(isEdit?"Save":"Add")+'</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(veil);

  if(isEdit){
    $("#m-category", veil).value = existing.category;
    $("#m-year", veil).value = existing.year || "";
    $("#m-title", veil).value = existing.title || "";
    $("#m-group", veil).value = existing.group || "";
    $("#m-status", veil).value = existing.status || "";
    $("#m-notes", veil).value = existing.notes || "";
    $("#m-fi", veil).checked = !!existing.enteredFI;
  } else {
    $("#m-year", veil).value = new Date().getFullYear();
    if(state.filter.category) $("#m-category", veil).value = state.filter.category;
  }

  function close(){ document.body.removeChild(veil); }
  veil.addEventListener("click", function(ev){ if(ev.target === veil) close(); });
  $("#m-cancel", veil).addEventListener("click", close);
  if(isEdit){
    $("#m-delete", veil).addEventListener("click", function(){
      if(confirm("Delete this activity?")){ deleteEntry(existing.id); close(); }
    });
  }
  $("#m-save", veil).addEventListener("click", function(){
    var title = $("#m-title", veil).value.trim();
    if(!title){ $("#m-title", veil).focus(); return; }
    var data = {
      category: $("#m-category", veil).value,
      year: $("#m-year", veil).value || new Date().getFullYear(),
      title: title,
      group: $("#m-group", veil).value.trim(),
      status: $("#m-status", veil).value,
      notes: $("#m-notes", veil).value.trim(),
      enteredFI: $("#m-fi", veil).checked
    };
    upsertEntry(data, isEdit ? existing.id : null);
    close();
  });
}

function openProfileModal(){
  var p = state.profile || DEFAULT_PROFILE;
  var veil = document.createElement("div");
  veil.className = "modal-veil";
  veil.innerHTML =
    '<div class="modal">' +
      '<h3>Header details for your generated CV</h3>' +
      '<div class="field"><label>Full name</label><input type="text" id="p-name"></div>' +
      '<div class="field"><label>Title / role</label><input type="text" id="p-role"></div>' +
      '<div class="field"><label>Institution / unit</label><input type="text" id="p-org"></div>' +
      '<div class="field"><label>Contact line</label><input type="text" id="p-contact"></div>' +
      '<div class="modal-actions"><span></span><div class="right"><button class="btn subtle" id="p-cancel">Cancel</button><button class="btn primary" id="p-save">Save</button></div></div>' +
    '</div>';
  document.body.appendChild(veil);
  $("#p-name", veil).value = p.name; $("#p-role", veil).value = p.role;
  $("#p-org", veil).value = p.org; $("#p-contact", veil).value = p.contact;
  function close(){ document.body.removeChild(veil); }
  veil.addEventListener("click", function(ev){ if(ev.target===veil) close(); });
  $("#p-cancel", veil).addEventListener("click", close);
  $("#p-save", veil).addEventListener("click", function(){
    saveProfile({
      name: $("#p-name", veil).value.trim() || DEFAULT_PROFILE.name,
      role: $("#p-role", veil).value.trim(),
      org: $("#p-org", veil).value.trim(),
      contact: $("#p-contact", veil).value.trim()
    });
    close();
  });
}

/* ============== Wire up static controls ============== */
document.addEventListener("DOMContentLoaded", function(){
  $all("nav.views button").forEach(function(b){
    b.addEventListener("click", function(){ switchView(b.dataset.view); });
  });
  $all("[data-goto]").forEach(function(b){
    b.addEventListener("click", function(){ switchView(b.dataset.goto); });
  });
  $("#add-entry-btn").addEventListener("click", function(){ openEntryModal(null); });
  $("#edit-profile-btn").addEventListener("click", openProfileModal);

  $("#search-input").addEventListener("input", function(){
    state.filter.query = this.value; renderActivityView();
    if(state.view !== "activity") switchView("activity");
  });
  $("#filter-category").addEventListener("change", function(){ state.filter.category = this.value; renderActivityView(); });
  $("#filter-year-min").addEventListener("input", function(){ state.filter.yearMin = this.value; renderActivityView(); });
  $("#filter-year-max").addEventListener("input", function(){ state.filter.yearMax = this.value; renderActivityView(); });
  $("#filter-window-toggle").addEventListener("click", function(){
    state.filter.windowOnly = !state.filter.windowOnly;
    this.classList.toggle("on", state.filter.windowOnly);
    renderActivityView();
  });
  $("#prep-hide-done").addEventListener("click", function(){
    state.prepHideDone = !state.prepHideDone;
    this.classList.toggle("on", state.prepHideDone);
    renderPrepView();
  });

  $("#fi-copy-all-btn").addEventListener("click", function(){ copyText(fiFullText()); });
  $("#fi-download-btn").addEventListener("click", function(){
    var txt = fiFullText();
    window.claude && window.claude.use && window.claude.use("downloads").then(function(dl){
      if(!dl){ downloadTextFallback(txt, "faculty-insight-import.txt"); return; }
      dl.save({filename:"faculty-insight-import.txt", data: txt}).catch(function(err){
        if(err && err.code !== "declined") showToast("Couldn't save the file here");
      });
    }).catch(function(){ downloadTextFallback(txt, "faculty-insight-import.txt"); });
  });

  $("#cv-copy-btn").addEventListener("click", function(){ copyText(buildCVMarkdown()); });
  $("#cv-print-btn").addEventListener("click", function(){ window.print(); });
  $("#cv-download-btn").addEventListener("click", function(){
    var md = buildCVMarkdown();
    window.claude && window.claude.use && window.claude.use("downloads").then(function(dl){
      if(!dl){ downloadViaAnchorFallback(md); return; }
      dl.save({filename:"mosher-cv.md", data: md}).catch(function(err){
        if(err && err.code !== "declined") showToast("Couldn't save the file here");
      });
    }).catch(function(){ downloadViaAnchorFallback(md); });
  });

  setInterval(renderDeadlineChip, 60000);
  initPersistence();
});

function downloadViaAnchorFallback(text){ downloadTextFallback(text, "mosher-cv.md"); }
function downloadTextFallback(text, filename){
  try{
    var blob = new Blob([text], {type:"text/plain"});
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob); a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  }catch(e){ showToast("Couldn't generate a file here — try Copy instead."); }
}

})();
</script>

