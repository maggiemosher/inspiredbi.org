<div class="toast" id="toast"></div>

<script>
(function(){
"use strict";

/* ============== Category config ============== */
var CATEGORIES = [
  {key:"publication", label:"Scholarship & Publications", cv:"Scholarship & Creative Works"},
  {key:"presentation", label:"Presentations", cv:"Presentations"},
  {key:"grant", label:"Grants & Contracts", cv:"Grants & Contracts"},
  {key:"teaching", label:"Teaching", cv:"Higher Education Teaching Experience"},
  {key:"service_university", label:"University Service", cv:"University Service"},
  {key:"service_scholarly", label:"Scholarly Service", cv:"Scholarly Service"},
  {key:"service_community", label:"Community Service", cv:"Community Service"},
  {key:"award", label:"Awards & Honors", cv:"Awards & Honors"},
  {key:"certification", label:"Certifications & Licensure", cv:"Certification"},
  {key:"position", label:"Professional Positions", cv:"Professional Experience"},
  {key:"education", label:"Education", cv:"Education"},
  {key:"media", label:"Podcast & Media", cv:"Podcast & Media"},
  {key:"student_mentoring", label:"Student Mentoring", cv:"Student Mentoring"},
  {key:"student_achievement", label:"Student Achievements", cv:"Student Achievements"}
];
var CAT_ORDER = CATEGORIES.map(function(c){return c.key;});
var CAT_BY_KEY = {};
CATEGORIES.forEach(function(c){ CAT_BY_KEY[c.key] = c; });

var WINDOW_START_YEAR = 2025, WINDOW_END_YEAR = 2026;
var DEADLINE = new Date("2027-03-01T17:00:00-06:00");

var DEFAULT_PROFILE = {
  name: "Margaret A. Mosher, Ph.D.",
  role: "Assistant Research Professor",
  org: "Achievement & Assessment Institute, University of Kansas",
  contact: "mosherku@ku.edu  |  816-824-5864  |  inspiredbi.org  |  orcid.org/0000-0001-9079-231X"
};

/* ============== State ============== */
var state = {
  entries: [],
  profile: null,
  view: "overview",
  filter: { category:"", yearMin:"", yearMax:"", windowOnly:false, query:"" },
  prepHideDone: false
};

var db = null, dbAvailable = false;
var dataReady = false; // true once we've received a real (even if empty) answer for state.entries
var storageKey = "faculty-tracker-fallback-v1";

/* ============== Utilities ============== */
function $(sel, root){ return (root||document).querySelector(sel); }
function $all(sel, root){ return Array.prototype.slice.call((root||document).querySelectorAll(sel)); }
function esc(s){
  return String(s==null?"":s).replace(/[&<>"']/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
}
function uid(){ return "e-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2,8); }
function showToast(msg){
  var t = $("#toast"); t.textContent = msg; t.classList.add("show");
  clearTimeout(showToast._t);
  showToast._t = setTimeout(function(){ t.classList.remove("show"); }, 2400);
}
function statusClass(s){
  if(!s) return "";
  var k = s.toLowerCase().replace(/\s+/g,"");
  if(k==="funded") return "status-funded";
  if(k==="notfunded") return "status-notfunded";
  if(k==="underreview") return "status-underreview";
  if(k==="inprogress") return "status-inprogress";
  return "";
}
function inWindow(e){ return e.year >= WINDOW_START_YEAR && e.year <= WINDOW_END_YEAR; }

/* ============== Persistence layer (db capability with localStorage fallback) ============== */
function loadFallback(){
  try{
    var raw = localStorage.getItem(storageKey);
    if(raw) return JSON.parse(raw);
  }catch(e){}
  return null;
}
function saveFallback(){
  try{
    localStorage.setItem(storageKey, JSON.stringify({entries: state.entries, profile: state.profile}));
  }catch(e){}
}

function setSyncStatus(txt){ var el = $("#stat-sync"); if(el) el.textContent = txt; }

function initPersistence(){
  if(!window.claude || typeof window.claude.use !== "function"){
    startFallback();
    scheduleHardFallback();
    return;
  }
  window.claude.use("db").then(function(d){
    if(!d){ startFallback(); return; }
    db = d; dbAvailable = true;
    setSyncStatus("Live");
    subscribeEntries();
    subscribeProfile();
  }).catch(function(){ startFallback(); });

  scheduleHardFallback();
}

// Guarantees the app can never get permanently stuck showing nothing, no matter which
// step silently hangs (the capability bridge, a live db connection that never actually
// delivers a snapshot, a network blip fetching seed.json, etc). Bases everything on
// `dataReady` rather than `dbAvailable` — a "connected but never delivered" db is exactly
// the failure mode a check on dbAvailable alone would miss.
function scheduleHardFallback(){
  setTimeout(function(){
    if(!dataReady && !fallbackStarted){ startFallback(); }
  }, 4000);
  setTimeout(function(){
    if(dataReady) return;
    fetchSeed(true).then(function(seed){
      if(dataReady) return;
      state.entries = seed;
      state.profile = state.profile || DEFAULT_PROFILE;
      dataReady = true;
      hideSeedOverlay();
      renderAll();
      showToast("Loaded your CV from backup — live sync wasn't responding");
    }).catch(function(){
      if(dataReady) return;
      dataReady = true;
      hideSeedOverlay();
      renderAll();
      showToast("Couldn't load your data — please reload the page");
    });
  }, 9000);
}

var fallbackStarted = false;
function startFallback(){
  if(fallbackStarted) return;
  fallbackStarted = true;
  setSyncStatus("This device only");
  var saved = loadFallback();
  if(saved && saved.entries && saved.entries.length){
    state.entries = saved.entries;
    state.profile = saved.profile || DEFAULT_PROFILE;
    dataReady = true;
    hideSeedOverlay();
    renderAll();
    // Merge in any newly-added seed rows (e.g. new categories) that predate this save.
    fetchSeed(true).then(function(seed){
      var existingIds = {}; state.entries.forEach(function(e){ existingIds[e.id]=true; });
      var extra = seed.filter(function(s){ return !existingIds[s.id]; });
      if(extra.length){ state.entries = state.entries.concat(extra); saveFallback(); renderAll(); }
    }).catch(function(){});
  } else {
    fetchSeed(true).then(function(seed){
      state.entries = seed;
      state.profile = DEFAULT_PROFILE;
      saveFallback();
      dataReady = true;
      hideSeedOverlay();
      renderAll();
    }).catch(function(){
      state.entries = [];
      state.profile = DEFAULT_PROFILE;
      dataReady = true;
      hideSeedOverlay();
      renderAll();
      showToast("Couldn't load your activity data — try reloading the page");
    });
  }
}

function fetchSeed(retryOnFail){
  return fetch("seed.json").then(function(r){
    if(!r.ok) throw new Error("no seed");
    return r.json();
  }).then(function(rows){
    return rows.map(function(r){
      return {
        id: r.id, category: r.category, group: r.group || "", year: r.year,
        title: r.title, status: r.status || "", notes: "", enteredFI: false,
        updatedAt: new Date().toISOString()
      };
    });
  }).catch(function(err){
    if(retryOnFail){
      // one retry after a short pause — covers a transient network blip fetching seed.json
      return new Promise(function(resolve){ setTimeout(resolve, 1200); }).then(function(){ return fetchSeed(false); });
    }
    throw err;
  });
}

function subscribeEntries(){
  db.collection("entries").onSnapshot(function(snap){
    var rows = snap.docs.map(function(d){ var v = d.data() || {}; v.id = d.id; return v; });
    state.entries = rows;
    dataReady = true;
    hideSeedOverlay();
    renderAll();
    maybeSeed();
  }, function(err){
    console.error("entries snapshot error", err);
    showToast("Trouble syncing your activity data — try reloading the page");
  });
}

function subscribeProfile(){
  db.doc("meta/profile").onSnapshot(function(snap){
    state.profile = (snap.exists && snap.data()) ? snap.data() : DEFAULT_PROFILE;
    renderProfileLine();
    if(state.view === "cv") renderCVView();
  }, function(err){ console.error("profile snapshot error", err); });
}

var seedAttempted = false;
function maybeSeed(){
  if(seedAttempted) return;
  seedAttempted = true;
  // Always diff against seed.json (not just a one-time "seeded" flag) so that if the
  // underlying CV seed data is ever refreshed/extended, new rows still land for
  // people who already seeded once — runSeed() below is a no-op when nothing is new.
  runSeed();
}

function runSeed(){
  fetchSeed(true).then(function(seed){
    var existingIds = {};
    state.entries.forEach(function(e){ existingIds[e.id] = true; });
    var todo = seed.filter(function(s){ return !existingIds[s.id]; });
    if(todo.length === 0){
      db.doc("meta/status").set({seeded:true, count: seed.length, seededAt: new Date().toISOString()});
      hideSeedOverlay();
      return;
    }
    showSeedOverlay();
    var i = 0;
    function next(){
      if(i >= todo.length){
        db.doc("meta/status").set({seeded:true, count: seed.length, seededAt: new Date().toISOString()});
        hideSeedOverlay();
        return;
      }
      var row = todo[i];
      $("#seed-status") && ($("#seed-status").textContent = "Loading your CV into the tracker… (" + (i+1) + " / " + todo.length + ")");
      db.collection("entries").doc(row.id).set({
        category: row.category, group: row.group || "", year: row.year, title: row.title,
        status: row.status || "", notes: "", enteredFI: false, updatedAt: new Date().toISOString()
      }).then(function(){ i++; next(); }).catch(function(){ i++; next(); });
    }
    next();
  }).catch(function(){ hideSeedOverlay(); });
}

function showSeedOverlay(){ var o = $("#seed-overlay"); if(o) o.hidden = false; }
function hideSeedOverlay(){ var o = $("#seed-overlay"); if(o) o.hidden = true; }

/* ============== CRUD ============== */
function upsertEntry(data, id){
  var isNew = !id;
  var payload = {
    category: data.category, group: data.group || "", year: Number(data.year),
    title: data.title, status: data.status || "", notes: data.notes || "",
    enteredFI: !!data.enteredFI, updatedAt: new Date().toISOString()
  };
  if(dbAvailable){
    var ref = id ? db.collection("entries").doc(id) : db.collection("entries").doc(uid());
    return ref.set(payload).then(function(){ showToast(isNew ? "Added to your CV" : "Saved"); });
  } else {
    if(id){
      var idx = state.entries.findIndex(function(e){ return e.id === id; });
      if(idx >= 0) state.entries[idx] = Object.assign({id:id}, payload);
    } else {
      payload.id = uid();
      state.entries.push(payload);
    }
    saveFallback(); renderAll();
    showToast(isNew ? "Added to your CV" : "Saved");
    return Promise.resolve();
  }
}

function deleteEntry(id){
  if(dbAvailable){
    return db.collection("entries").doc(id).delete().then(function(){ showToast("Deleted"); });
  } else {
    state.entries = state.entries.filter(function(e){ return e.id !== id; });
    saveFallback(); renderAll();
    showToast("Deleted");
    return Promise.resolve();
  }
}

function toggleFI(id, val){
  if(dbAvailable){
    db.collection("entries").doc(id).update({enteredFI: val, updatedAt: new Date().toISOString()}).catch(function(e){
      console.error(e);
    });
  } else {
    var e = state.entries.find(function(x){ return x.id === id; });
    if(e){ e.enteredFI = val; saveFallback(); }
    renderAll();
  }
}

function saveProfile(p){
  state.profile = p;
  if(dbAvailable){
    db.doc("meta/profile").set(p).then(function(){ showToast("Header updated"); });
  } else {
    saveFallback();
    showToast("Header updated");
    renderProfileLine(); renderCVView();
  }
}

/* ============== Rendering: shell ============== */
function switchView(view){
  state.view = view;
  $all("nav.views button").forEach(function(b){ b.classList.toggle("active", b.dataset.view === view); });
  $all(".view").forEach(function(v){ v.classList.remove("active"); });
  $("#view-" + view).classList.add("active");
  window.scrollTo(0,0);
  if(view === "cv") renderCVView();
  if(view === "activity") renderActivityView();
  if(view === "prep") renderPrepView();
  if(view === "fi") renderFIView();
  if(view === "overview") renderOverview();
}

function renderProfileLine(){
  var p = state.profile || DEFAULT_PROFILE;
  $("#who-line").textContent = p.name || DEFAULT_PROFILE.name;
}

function renderDeadlineChip(){
  var now = new Date();
  var ms = DEADLINE - now;
  var days = Math.ceil(ms / 86400000);
  var txt;
  if(days > 0) txt = days + " day" + (days===1?"":"s") + " to KBOR deadline";
  else txt = "KBOR deadline has passed";
  $("#deadline-chip").innerHTML = "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 3'/></svg> <b class='tabular'>" + txt + "</b>";
  $("#fi-days").textContent = days > 0 ? days : "0";
  var totalWindowDays = Math.round((DEADLINE - new Date("2026-01-01T00:00:00-06:00"))/86400000);
  var elapsed = totalWindowDays - days;
  var pct = Math.max(2, Math.min(100, Math.round(100 * elapsed / totalWindowDays)));
}

function renderAll(){
  renderProfileLine();
  renderDeadlineChip();
  renderOverview();
  renderActivityView();
  renderPrepView();
  if(state.view === "cv") renderCVView();
  if(state.view === "fi") renderFIView();
  $("#stat-total").textContent = state.entries.length;
  $("#stat-window").textContent = state.entries.filter(inWindow).length;
}

/* ============== Overview ============== */
function renderOverview(){
  var entries = state.entries;
  var winEntries = entries.filter(inWindow);
  var notEntered = winEntries.filter(function(e){ return !e.enteredFI; });

  $("#fi-progress-fill").style.width = winEntries.length ? Math.round(100*(winEntries.length-notEntered.length)/winEntries.length) + "%" : "0%";
  $("#fi-banner-text").innerHTML = winEntries.length
    ? (winEntries.length - notEntered.length) + " of " + winEntries.length + " window activities marked as entered in Faculty Insight."
    : "Your first KU Faculty Insight report must cover Jan 2025 – Dec 2026, due 5:00 PM Monday, March 1, 2027.";

  var grid = $("#stat-grid");
  var tiles = [
    {n: entries.length, l:"Total activities logged"},
    {n: winEntries.length, l:"In the 2025–2026 window"},
    {n: entries.filter(function(e){return e.category==="publication";}).length, l:"Publications"},
    {n: entries.filter(function(e){return e.category==="presentation";}).length, l:"Presentations"},
    {n: entries.filter(function(e){return e.category==="grant";}).length, l:"Grants & contracts"},
    {n: notEntered.length, l:"Not yet in Faculty Insight"}
  ];
  grid.innerHTML = tiles.map(function(t){
    return '<div class="stat-tile"><div class="n tabular">'+t.n+'</div><div class="lbl">'+t.l+'</div></div>';
  }).join("");

  var catGrid = $("#cat-grid");
  catGrid.innerHTML = CATEGORIES.map(function(c){
    var n = entries.filter(function(e){ return e.category === c.key; }).length;
    return '<div class="cat-card" data-cat="'+c.key+'"><div class="n tabular">'+n+'</div><div class="l">'+esc(c.label)+'</div></div>';
  }).join("");
  $all(".cat-card", catGrid).forEach(function(el){
    el.addEventListener("click", function(){
      state.filter.category = el.dataset.cat;
      $("#filter-category").value = el.dataset.cat;
      switchView("activity");
      renderActivityView();
    });
  });

  var recent = entries.slice().sort(function(a,b){ return (b.updatedAt||"").localeCompare(a.updatedAt||""); }).slice(0,6);
  $("#recent-list").innerHTML = recent.length ? recent.map(rowHTML).join("") : '<div class="empty-state">Nothing logged yet — click "Add activity" to get started.</div>';
  bindRowActions($("#recent-list"));
}

/* ============== Activity list ============== */
function populateCategoryFilter(){
  var sel = $("#filter-category");
  if(sel.options.length > 1) return;
  CATEGORIES.forEach(function(c){
    var o = document.createElement("option"); o.value = c.key; o.textContent = c.label; sel.appendChild(o);
  });
}

function filteredEntries(){
  var f = state.filter;
  return state.entries.filter(function(e){
    if(f.category && e.category !== f.category) return false;
    if(f.windowOnly && !inWindow(e)) return false;
    if(f.yearMin && e.year < Number(f.yearMin)) return false;
    if(f.yearMax && e.year > Number(f.yearMax)) return false;
    if(f.query){
      var q = f.query.toLowerCase();
      var hay = (e.title + " " + (e.group||"") + " " + (e.notes||"")).toLowerCase();
      if(hay.indexOf(q) === -1) return false;
    }
    return true;
  });
}

function rowHTML(e){
  var cat = CAT_BY_KEY[e.category] || {label:e.category};
  var badges = '<span class="badge cat">'+esc(cat.label)+'</span>';
  if(e.status) badges += '<span class="badge '+statusClass(e.status)+'">'+esc(e.status)+'</span>';
  if(inWindow(e)){
    badges += e.enteredFI ? '<span class="badge fi-yes">✓ In Faculty Insight</span>' : '<span class="badge fi-no">Not yet in FI</span>';
  }
  return '<div class="entry-row" data-id="'+e.id+'">' +
    '<div class="entry-year tabular">'+(e.year||"")+'</div>' +
    '<div class="entry-body">' +
      (e.group ? '<div style="font-size:11.5px;color:var(--muted);margin-bottom:3px;">'+esc(e.group)+'</div>' : '') +
      '<div class="entry-title">'+esc(e.title)+(e.notes ? ' <span style="color:var(--muted);font-size:12px;">— '+esc(e.notes)+'</span>' : '')+'</div>' +
      '<div class="entry-meta">'+badges+'</div>' +
    '</div>' +
    '<div class="entry-actions">' +
      '<button class="icon-btn" data-act="edit" title="Edit"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>' +
      '<button class="icon-btn" data-act="delete" title="Delete"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg></button>' +
    '</div>' +
  '</div>';
}

function bindRowActions(root){
  $all(".entry-row", root).forEach(function(row){
    var id = row.dataset.id;
    var editBtn = row.querySelector('[data-act="edit"]');
    var delBtn = row.querySelector('[data-act="delete"]');
    if(editBtn) editBtn.addEventListener("click", function(){ openEntryModal(state.entries.find(function(e){return e.id===id;})); });
    if(delBtn) delBtn.addEventListener("click", function(){
      if(confirm("Delete this activity from your tracker? This won't affect anything already submitted to Faculty Insight.")){
        deleteEntry(id);
      }
    });
    row.addEventListener("click", function(ev){
      if(ev.target.closest(".entry-actions")) return;
      openEntryModal(state.entries.find(function(e){return e.id===id;}));
    });
  });
}

function renderActivityView(){
  populateCategoryFilter();
  var list = filteredEntries();
  $("#activity-count").textContent = list.length + " of " + state.entries.length + " activities";

  var groups = {};
  CAT_ORDER.forEach(function(k){ groups[k] = []; });
  list.forEach(function(e){ (groups[e.category] = groups[e.category] || []).push(e); });

  var html = "";
  var catsToShow = state.filter.category ? [state.filter.category] : CAT_ORDER;
  catsToShow.forEach(function(catKey){
    var rows = (groups[catKey]||[]).slice().sort(function(a,b){ return (b.year||0)-(a.year||0); });
    if(!rows.length) return;
    html += '<div class="group-heading">'+esc((CAT_BY_KEY[catKey]||{}).label||catKey)+' · '+rows.length+'</div>';
    html += rows.map(rowHTML).join("");
  });
  $("#activity-list").innerHTML = html || '<div class="empty-state">No activities match these filters.</div>';
  bindRowActions($("#activity-list"));
}

