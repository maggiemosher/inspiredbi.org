/* ============== Faculty Insight Import (KU Activity Manager taxonomy) ============== */

// --- classifiers: map this tracker's categories onto Faculty Insight's exact sub-sections,
// using only signals already present in the CV text (group labels, status, keywords). Nothing here
// is invented — ambiguous cases are routed to a reasonable default and flagged for a quick check.

function fiClassifyPublication(e){
  var t = e.title || "", g = e.group || "";
  if(/proceedings/i.test(t)) return "conference_proceedings";
  if(/foldable|infographic|toolkit|handout|guide(?!\w)/i.test(t) && /National Professional Resources|CIDDL|Center for/i.test(t)) return "educational_materials";
  if(/books and book chapters/i.test(g)) return "book_chapters";
  if(/other publications/i.test(g)) return "other_publications";
  if(/manuscripts? (under review|in preparation)/i.test(g)) return "other_publications";
  return "journal_articles";
}
function fiClassifyGrant(e){
  var t = e.title || "";
  if(e.status === "Funded") return "grants_funded";
  if(/\bawarded\b/i.test(t) && e.status !== "Not Funded") return "grants_funded";
  return "grants_proposal"; // includes "Not Funded" and unspecified-status proposals
}
function fiClassifyServiceScholarly(e){
  var t = e.title || "", g = e.group || "";
  if(/^memberships$/i.test(g) || /\bmember\b|\bvice president\b|\bpresident\b/i.test(t)) return "professional_membership";
  return "professional_service";
}

// entry -> plain text line for pasting (each entry's own CV phrasing already carries its date)
function fiLine(e){ return (e.title || "").trim(); }

function fiCourseCode(title){
  var m = (title||"").match(/^([^:]{2,40}):/);
  return m ? m[1].replace(/[†‡]/g,"").trim() : (title||"").slice(0,40);
}

// Awards & Honors: break each CV award line into Faculty Insight's 6 fields using only what the
// line itself says. Anything not stated in the CV is left as an explicit placeholder rather than guessed.
var AWARD_ORG_HINTS = ["University of Kansas","Baker University","Franciscan University","Missouri","Kansas","Ohio",
  "Department of Education","OSEP","Foundation","Association","Council","Community Foundation","L'Oréal","UNESCO",
  "Society","Institute","College","School District","District"];
var RECOGNITION_RULES = [
  [/fellowship/i, "Fellowship"],
  [/scholarship/i, "Scholarship"],
  [/\bgrant\b/i, "Research Grant/Award"],
  [/cum laude|summa|magna/i, "Academic Distinction"],
  [/dissertation/i, "Research/Dissertation Award"],
  [/recognition of excellence|leader award|educator award|horizon award|specialist of the year/i, "Professional Recognition Award"]
];
function fiParseAward(e){
  var raw = (e.title || "").trim();
  var yearMatch = raw.match(/^(\d{4}(?:\s*&\s*\d{4})?)\s+/);
  var receivedDate = yearMatch ? yearMatch[1] : (e.year || "");
  var rest = yearMatch ? raw.slice(yearMatch[0].length) : raw;

  var org = "", titlePart = rest;
  var parts = rest.split(",");
  if(parts.length > 1){
    var last = parts[parts.length-1].trim();
    var hinted = AWARD_ORG_HINTS.some(function(h){ return last.toLowerCase().indexOf(h.toLowerCase()) > -1; });
    if(hinted){ org = last; titlePart = parts.slice(0,-1).join(",").trim(); }
  }
  if(!org){
    var hit = AWARD_ORG_HINTS.find(function(h){ return rest.toLowerCase().indexOf(h.toLowerCase()) > -1; });
    if(hit) org = hit;
  }

  var recognition = "";
  for(var i=0;i<RECOGNITION_RULES.length;i++){ if(RECOGNITION_RULES[i][0].test(raw)){ recognition = RECOGNITION_RULES[i][1]; break; } }
  if(!recognition) recognition = "Award";

  return {
    title: titlePart || raw,
    receivedDate: receivedDate,
    org: org,
    recognition: recognition,
    description: raw
  };
}
function fiAwardCategory(e){
  var t = (e.title||"").toLowerCase();
  if(/teach|instruct(?!ional design)|educator award|leader award/.test(t)) return "Teaching";
  if(/service|leadership award|community/.test(t)) return "Service";
  return "Research";
}
function fiAwardBlock(e){
  var a = fiParseAward(e);
  return [
    "Title: " + a.title,
    "Received Date: " + a.receivedDate,
    "Awarding Organization/Sponsor: " + (a.org || "[Not stated in CV — please add]"),
    "Scope/Impact: [Not stated in CV — please specify, e.g., institutional / state / national / international]",
    "Description: " + a.description,
    "Type of Recognition: [Suggested: " + a.recognition + " — please verify]",
    "Type of Award: " + fiAwardCategory(e) + " [Best guess — Research/Teaching/Service — please verify]"
  ].join("\n");
}

function fiEmpty(label){ return "[No items found in your CV for " + label + ". Add these directly in Faculty Insight, or log them in the Activity Log here first.]"; }

function fiEntriesFor(catKey){ return state.entries.filter(function(e){ return e.category === catKey; }); }

// --- Degrees: Terminal Degree in Discipline / Highest Degree Earned, from CV text + rank comparison.
function fiParseDegree(e){
  var t = (e.title||"").trim();
  var m = t.match(/^(\d{4})\s+(Doctor of [A-Za-z]+|Master of [A-Za-z]+(?:\s+[A-Za-z]+)?|Bachelor of [A-Za-z]+(?:\s+[A-Za-z]+)?)\s+in\s+([^;]+);\s*([^.]+)\.?\s*$/);
  if(!m) return {year: e.year, degree: t, major: "", institution: "[Not stated in CV — please add]"};
  return {year: m[1], degree: m[2].trim(), major: m[3].trim(), institution: m[4].trim()};
}
function fiDegreeRank(degree){
  if(/^Doctor/i.test(degree)) return 3;
  if(/^Master/i.test(degree)) return 2;
  if(/^Bachelor/i.test(degree)) return 1;
  return 0;
}

// --- Professional Membership: best-guess Scope/Impact from the organization's own name.
function fiMembershipOrg(title){
  var t = (title||"").replace(/^\d{4}(?:\s*-\s*(?:\d{4}|present))?\s*/i, "").trim();
  t = t.replace(/^(Vice President|President|Board Member|Steering Committee|Member)\s+/i, "");
  return t.trim();
}
function fiMembershipDates(title){
  var m = (title||"").match(/^(\d{4})\s*-\s*(present|\d{4})/i);
  if(!m) return {start:"", end:""};
  return {start: m[1], end: /present/i.test(m[2]) ? "Present" : m[2]};
}
var MEMBERSHIP_SCOPE_KNOWN = {
  "council for exceptional children": "National/Federal",
  "association for supervision and curriculum development": "National/Federal",
  "learning disabilities association": "National/Federal",
  "national education association": "National/Federal",
  "national catholic education association": "National/Federal"
};
function fiMembershipScope(org){
  var lo = org.toLowerCase();
  if(/international/.test(lo)) return "International";
  if(/\bnational\b/.test(lo)) return "National/Federal";
  if(/\bamerican\b/.test(lo)) return "National/Federal";
  if(/\bkansas\b|\bmissouri\b|\bstate of\b/.test(lo)) return "State";
  if(/\bregional\b/.test(lo)) return "Regional";
  if(/\buniversity\b|\bcampus\b/.test(lo)) return "University";
  for(var k in MEMBERSHIP_SCOPE_KNOWN){ if(lo.indexOf(k) > -1) return MEMBERSHIP_SCOPE_KNOWN[k]; }
  return "Unknown";
}

// --- Professional Development: pull conference/venue names out of Presentations as a starting list.
function fiExtractVenue(title){
  var m = (title||"").match(/\]\.\s*(.+)$/);
  if(!m) return null;
  var rest = m[1].replace(/\.\s*$/, "");
  rest = rest.replace(/,\s*Online\s*$/i, "");
  rest = rest.replace(/,\s*[A-Za-z.\-' ]+,\s*[A-Z]{2},\s*(United States|Canada)\s*$/, "");
  rest = rest.replace(/,\s*[A-Za-z.\-' ]+,\s*(United States|Canada|[A-Za-z]+)\s*$/, "");
  rest = rest.replace(/,\s*[A-Za-z.\-' ]+\s*$/, "");
  rest = rest.replace(/^\d{4}\s+/, ""); // drop a leading year so the same venue in different years dedupes
  return rest.trim();
}

// --- Career / Professional Experience: flag consulting roles as Academic vs. Nonprofit.
function fiConsultingType(e){
  if(!/consult/i.test(e.title || "")) return null;
  if(/nonprofit|501\(c\)3|foundation|embrace/i.test(e.title)) return "Nonprofit";
  return "Academic";
}

// --- Journal Articles / Other Publications: Work Status.
function fiWorkStatus(e){
  var g = e.group || "";
  if(/manuscripts? under review/i.test(g)) return "In Submission";
  if(/manuscripts? in preparation/i.test(g)) return "In Preparation";
  return "Published";
}

// --- Grants: full Faculty Insight field order, best-guessed from free-text CV lines.
function fiGrantAmount(title){
  var m = (title||"").match(/^\$([\d,]+)/);
  return m ? "$" + m[1] : "[Not stated in CV — please add]";
}
function fiGrantDates(title){
  var t = title || "";
  var all = t.match(/\((\d{1,2}\/\d{1,2}\/\d{4})\s*-\s*(\d{1,2}\/\d{1,2}\/\d{4})\)/g);
  if(all && all.length){
    var mm = all[all.length-1].match(/\((\d{1,2}\/\d{1,2}\/\d{4})\s*-\s*(\d{1,2}\/\d{1,2}\/\d{4})\)/);
    return {start: mm[1], end: mm[2]};
  }
  all = t.match(/\((\d{4})\s*-\s*(\d{4})\)/g);
  if(all && all.length){
    var my = all[all.length-1].match(/\((\d{4})\s*-\s*(\d{4})\)/);
    return {start: my[1], end: my[2]};
  }
  all = t.match(/\((\d{4})\)/g);
  if(all && all.length){
    var ly = all[all.length-1].match(/\((\d{4})\)/);
    return {start: ly[1], end: ly[1]};
  }
  return {start: "[Not stated — please add]", end: "[Not stated — please add]"};
}
// Sponsor names as literally written in the CV, matched by substring (longest/most-specific first) —
// nothing here is invented, only detected among your own wording.
var GRANT_SPONSOR_HINTS = [
  ["U.S. Department of Education, Office of Special Education Programs (OSEP)", "U.S. Department of Education, Office of Special Education Programs (OSEP)"],
  ["U.S. Department of Education Office of Elementary and Secondary Education, Education and Innovation Research (EIR) Program", "U.S. Department of Education, Office of Elementary and Secondary Education, Education Innovation and Research (EIR) Program"],
  ["OESE Competitive Grants for State Assessments", "U.S. Department of Education, Office of Elementary and Secondary Education (OESE) — in collaboration with the Kansas State Department of Education"],
  ["Institute of Education Sciences", "Institute of Education Sciences (IES)"],
  ["National Science Foundation", "National Science Foundation (NSF)"],
  ["Google AI Accelerator", "Google"],
  ["OSEP", "U.S. Department of Education, Office of Special Education Programs (OSEP)"],
  ["Dunn Family Foundation", "Dunn Family Foundation"],
  ["Laughlin Foundation", "Laughlin Foundation"],
  ["Royal's Charities", "Royal's Charities"],
  ["Variety Children's Charity of Greater Kansas City", "Variety Children's Charity of Greater Kansas City"],
  ["Greater Kansas City Community Foundation", "Greater Kansas City Community Foundation"],
  ["Greater Kansas City Fund", "Greater Kansas City Fund"],
  ["Mimio Interactive Teaching Technology", "Mimio Interactive Teaching Technology"],
  ["Sherman Family Foundation", "Sherman Family Foundation"],
  ["New Schools Grant Project", "[Program name only in CV — sponsor/funder not clearly stated; please add]"]
];
function fiGrantSponsor(e){
  var t = e.title || "";
  for(var i=0;i<GRANT_SPONSOR_HINTS.length;i++){
    if(t.indexOf(GRANT_SPONSOR_HINTS[i][0]) > -1) return GRANT_SPONSOR_HINTS[i][1];
  }
  var m = t.match(/Awarded\s+(?:by|from)\s+([^.]+?)(?:\s+to\s+[^.]+)?\.?\s*$/i);
  if(m) return m[1].trim();
  m = t.match(/\b(?:by|from)\s+([A-Z][^.]+?)\.?\s*$/);
  if(m) return m[1].trim();
  return "[Not clearly stated in CV — please verify sponsor]";
}
function fiGrantTitleGoodMatch(text){
  var re = /([A-Z][A-Za-z0-9,:\-\s']{4,90}\s\(([A-Z][A-Za-z0-9\-:]{1,24})\))/g;
  var m;
  while((m = re.exec(text))){
    if(/^(Co-)?Principals?$|^Mentors?$|^Investigators?$|^Under$|^Review$/i.test(m[2])) continue;
    var overlapsSponsor = GRANT_SPONSOR_HINTS.some(function(h){ return m[1].indexOf(h[0]) > -1 || (m[2].length > 1 && h[0].indexOf(m[2]) > -1); });
    if(overlapsSponsor) continue;
    return m[1].trim();
  }
  return null;
}
function fiGrantTitleGuess(e){
  var t = e.title || "";
  var authors = fiGrantAuthors(e);
  if(authors){
    var idx = t.indexOf(authors);
    if(idx > -1){
      var after = fiGrantTitleGoodMatch(t.slice(idx + authors.length));
      if(after) return after;
      var before = fiGrantTitleGoodMatch(t.slice(0, idx));
      if(before) return before;
    }
  }
  var whole = fiGrantTitleGoodMatch(t);
  if(whole) return whole;
  var m2 = t.match(/\bProject\s+[A-Z][A-Za-z\-]{1,20}(?::\s*[^.(]{3,80})?/);
  if(m2) return m2[0].trim();
  return null;
}
function fiGrantAuthors(e){
  var t = e.title || "";
  var m = t.match(/([A-Z][a-zA-Z\-]+,\s*[A-Z]\.(?:\s*[A-Z]\.)?(?:\s*\([^)]+\))?(?:,\s*[A-Z][a-zA-Z\-]+,\s*[A-Z]\.(?:\s*[A-Z]\.)?(?:\s*\([^)]+\))?)*(?:,?\s*&\s*[A-Z][a-zA-Z\-]+,\s*[A-Z]\.(?:\s*[A-Z]\.)?(?:\s*\([^)]+\))?)?)/);
  return m ? m[1] : "";
}
function fiGrantAuthorOrder(authorsStr){
  if(!authorsStr) return "";
  var idx = authorsStr.toLowerCase().indexOf("mosher");
  if(idx === -1) return "";
  var before = authorsStr.slice(0, idx);
  var count = (before.match(/[A-Z][a-zA-Z\-]+,\s*[A-Z]\./g) || []).length;
  return String(count + 1);
}
function fiGrantRole(e){
  var t = e.title || "";
  if(/Mosher,?\s*M\.?\s*\(Principal\)/i.test(t)) return "Principal Investigator";
  if(/Mosher,?\s*M\.?\s*\(Co-\s*Principal\)/i.test(t)) return "Co-Principal Investigator";
  return "Co-Investigator [best guess — please verify role]";
}
function fiGrantScope(sponsor){
  var lo = sponsor.toLowerCase();
  if(/u\.s\. department|national science foundation|\bosep\b|\bfederal\b|\bnsf\b|institute of education sciences/.test(lo)) return "National/Federal";
  if(/foundation|charities|charity/.test(lo)) return "Regional";
  if(/university of kansas|internal/.test(lo)) return "Institutional";
  return "Unknown";
}
function fiGrantFundingSource(sponsor){
  var lo = sponsor.toLowerCase();
  if(/u\.s\. department|national science foundation|\bosep\b|\bfederal\b|\bnsf\b|institute of education sciences/.test(lo)) return "Federal";
  if(/foundation|charities|charity/.test(lo)) return "Private/Foundation";
  if(/university of kansas/.test(lo)) return "Institutional";
  if(/google|corporate|\binc\b|\bllc\b/.test(lo)) return "Industry";
  return "[Best guess unavailable — please select]";
}
function fiGrantTypeOfFunding(e){
  return /Funded Contracts/i.test(e.group || "") ? "Contract" : "Grant";
}
function fiGrantCommunityEngaged(title){
  return /communit(y|ies)|district|families|outreach|schools?\b/i.test(title) ? "Yes [best guess]" : "No [best guess]";
}
function fiGrantRefereed(title){
  return /invited/i.test(title) ? "Invited" : "Competitive [best guess — most federal/foundation grants are competitive]";
}
function fiAffiliationForYear(year){
  if(!year) return "University of Kansas [best guess]";
  if(year >= 2019) return "University of Kansas";
  if(year >= 2017) return "EMBRACE";
  if(year >= 2013) return "Baker University";
  if(year >= 2012) return "Curé of Ars";
  if(year >= 2007) return "St. Agnes";
  if(year >= 2005) return "Madison Elementary / USD 231";
  return "Steubenville City Schools";
}
function fiGrantCFDA(title){
  var m = (title||"").match(/CFDA[#\s]*([\d.]+[A-Z]?)/i);
  return m ? m[1] : "";
}
function fiGrantOtherCollaborators(authorsStr){
  if(!authorsStr) return "[Not stated in CV — add via Faculty Insight's collaborator search]";
  var names = authorsStr.split(/,\s*&\s*|\s*&\s*|,\s*(?=[A-Z][a-zA-Z\-]+,\s*[A-Z]\.)/).map(function(s){ return s.trim(); }).filter(Boolean);
  var others = names.filter(function(n){ return n.toLowerCase().indexOf("mosher") === -1; });
  return others.length ? others.join("; ") : "[None besides you listed in the CV text]";
}
function fiGrantBlock(e){
  var dates = fiGrantDates(e.title);
  var sponsor = fiGrantSponsor(e);
  var authors = fiGrantAuthors(e);
  var cfda = fiGrantCFDA(e.title);
  var fundingStatus = e.status === "Funded" ? "Funded"
    : e.status === "Not Funded" ? "Submitted, Not Funded"
    : /Prior Funded|Funded Contracts/i.test(e.group||"") ? "Funded"
    : "Submitted";
  var titleGuess = fiGrantTitleGuess(e);
  var titleOut = titleGuess || (e.title.length > 160 ? e.title.slice(0,160) + "… [Full CV text is long — shorten to a project title]" : e.title + " [Shorten to a project title if needed]");
  return [
    "Start Date: " + dates.start,
    "End Date: " + dates.end,
    "Ongoing: No",
    "Title: " + titleOut,
    "Sponsor: " + sponsor,
    "Dollar Amount: " + fiGrantAmount(e.title),
    "Scope/Impact: " + fiGrantScope(sponsor) + " [best guess]",
    "Funding Status: " + fundingStatus,
    "Proposal/Award/Contract ID: " + (cfda ? ("CFDA " + cfda) : "[Not stated in CV — please add]"),
    "University Grant ID: [Not tracked in CV — add from KU Office of Research records if available]",
    "URL/Link: [Not stated in CV]",
    "Abstract: " + e.title,
    "Add to KU Web Profile?: Yes [default — change if you'd rather not publish this one]",
    "Community-engaged activity?: " + fiGrantCommunityEngaged(e.title),
    "Funding Source: " + fiGrantFundingSource(sponsor),
    "Type of Funding: " + fiGrantTypeOfFunding(e),
    "Submitted Date: " + dates.start + " [best guess — actual submission date may be earlier]",
    "Refereed/Competitive or Invited: " + fiGrantRefereed(e.title),
    "Affiliation at Time of Submittal: " + fiAffiliationForYear(e.year) + " [best guess from your CV timeline — please verify]",
    "Description: " + e.title,
    "— Add Collaborators —",
    "Your Information — First Name: Maggie | Middle Name: Anne | Last Name: Mosher | Affiliation: University of Kansas, The | Author Order: " + (fiGrantAuthorOrder(authors) || "[check CV author order]") + " | Role(s): " + fiGrantRole(e) + " | Student?: No",
    "Other Collaborators: " + fiGrantOtherCollaborators(authors)
  ].join("\n");
}

