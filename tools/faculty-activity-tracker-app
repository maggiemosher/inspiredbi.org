<!doctype html><html><head><meta charset=utf8><meta name="robots" content="noindex, nofollow"><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Faculty Activity Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f5f1e8;
    --surface:#ffffff;
    --surface-2:#eee8d8;
    --border:#ddd3ba;
    --ink:#20242c;
    --ink-soft:#5b5748;
    --muted:#8a8472;
    --accent:#1f3a5f;
    --accent-ink:#ffffff;
    --accent-soft:#e4ecf3;
    --gold:#9c6b1f;
    --gold-soft:#f3e7cf;
    --good:#2b7a4b;
    --good-soft:#e2f1e6;
    --warn:#a5680f;
    --warn-soft:#f7ecd9;
    --bad:#a13d3d;
    --bad-soft:#f6e4e2;
    --shadow: 0 1px 2px rgba(32,26,10,0.06), 0 6px 20px -8px rgba(32,26,10,0.18);
    --radius: 10px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#14171d;
      --surface:#1b2028;
      --surface-2:#242a34;
      --border:#333b47;
      --ink:#eef0f3;
      --ink-soft:#b7bec9;
      --muted:#7d8894;
      --accent:#7ea3cc;
      --accent-ink:#0f1721;
      --accent-soft:#233144;
      --gold:#dcac5c;
      --gold-soft:#3a301c;
      --good:#6cc191;
      --good-soft:#1c3226;
      --warn:#e0b25e;
      --warn-soft:#3a2f18;
      --bad:#e39494;
      --bad-soft:#3a2222;
      --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 10px 30px -10px rgba(0,0,0,0.6);
    }
  }
  :root[data-theme="dark"]{
    --bg:#14171d;
    --surface:#1b2028;
    --surface-2:#242a34;
    --border:#333b47;
    --ink:#eef0f3;
    --ink-soft:#b7bec9;
    --muted:#7d8894;
    --accent:#7ea3cc;
    --accent-ink:#0f1721;
    --accent-soft:#233144;
    --gold:#dcac5c;
    --gold-soft:#3a301c;
    --good:#6cc191;
    --good-soft:#1c3226;
    --warn:#e0b25e;
    --warn-soft:#3a2f18;
    --bad:#e39494;
    --bad-soft:#3a2222;
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 10px 30px -10px rgba(0,0,0,0.6);
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:"IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    font-size:15px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{
    font-family:"Source Serif 4", Georgia, serif;
    font-weight:600;
    margin:0 0 .3em;
    text-wrap:balance;
    color:var(--ink);
  }
  a{color:var(--accent);}
  .tabular{font-variant-numeric:tabular-nums;}
  .mono{font-family:"IBM Plex Mono", ui-monospace, monospace;}
  button{font-family:inherit;}
  ::selection{background:var(--accent-soft);}

  #app{display:flex; min-height:100vh; max-width:1440px; margin:0 auto;}

  /* ---- Side rail ---- */
  #rail{
    width:220px; flex:0 0 220px;
    border-right:1px solid var(--border);
    padding:20px 14px;
    display:flex; flex-direction:column; gap:18px;
    position:sticky; top:0; align-self:flex-start; height:100vh; overflow-y:auto;
  }
  .brand{padding:2px 6px 10px;}
  .brand .kicker{
    font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--gold); font-weight:600;
  }
  .brand h1{font-size:19px; line-height:1.2; margin-top:2px;}
  .brand .who{font-size:12.5px; color:var(--ink-soft); margin-top:4px;}

  nav.views{display:flex; flex-direction:column; gap:2px;}
  nav.views button{
    all:unset; cursor:pointer; padding:9px 10px; border-radius:8px;
    font-size:13.5px; font-weight:500; color:var(--ink-soft);
    display:flex; align-items:center; gap:9px;
  }
  nav.views button .dot{width:7px;height:7px;border-radius:50%;background:var(--border); flex:0 0 auto;}
  nav.views button:hover{background:var(--surface-2); color:var(--ink);}
  nav.views button.active{background:var(--accent-soft); color:var(--accent); font-weight:600;}
  nav.views button.active .dot{background:var(--accent);}

  .rail-stats{
    margin-top:auto; padding-top:14px; border-top:1px solid var(--border);
    display:flex; flex-direction:column; gap:8px;
  }
  .rail-stat{display:flex; justify-content:space-between; font-size:12.5px; color:var(--ink-soft);}
  .rail-stat b{color:var(--ink); font-family:"IBM Plex Mono", monospace;}

  #rail-toggle{display:none;}

  /* ---- Main ---- */
  #main{flex:1; min-width:0; display:flex; flex-direction:column;}
  #topbar{
    position:sticky; top:0; z-index:5; background:var(--bg);
    border-bottom:1px solid var(--border);
    padding:14px 26px; display:flex; align-items:center; gap:14px; flex-wrap:wrap;
  }
  #topbar .spacer{flex:1;}
  .search-wrap{
    display:flex; align-items:center; gap:8px; background:var(--surface); border:1px solid var(--border);
    border-radius:8px; padding:7px 11px; min-width:220px; flex:1; max-width:380px;
  }
  .search-wrap svg{flex:0 0 auto; opacity:.55;}
  .search-wrap input{
    all:unset; flex:1; font-size:13.5px; color:var(--ink);
  }
  .search-wrap input::placeholder{color:var(--muted);}

  .btn{
    display:inline-flex; align-items:center; gap:7px; border-radius:8px; border:1px solid var(--border);
    background:var(--surface); color:var(--ink); font-size:13.5px; font-weight:500; padding:8px 13px; cursor:pointer;
    white-space:nowrap;
  }
  .btn:hover{border-color:var(--ink-soft);}
  .btn.primary{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
  .btn.primary:hover{filter:brightness(1.06);}
  .btn.subtle{border-color:transparent; background:transparent;}
  .btn.subtle:hover{background:var(--surface-2);}
  .btn.danger{color:var(--bad);}
  .btn:disabled{opacity:.5; cursor:default;}
  .btn svg{flex:0 0 auto;}

  .deadline-chip{
    display:flex; align-items:center; gap:8px; padding:7px 12px; border-radius:999px;
    background:var(--gold-soft); color:var(--gold); font-size:12.5px; font-weight:600; white-space:nowrap;
  }
  .deadline-chip b{font-family:"IBM Plex Mono", monospace; font-weight:600;}

  #content{padding:22px 26px 60px; flex:1;}
  .view{display:none;}
  .view.active{display:block;}

  /* ---- Overview ---- */
  .stat-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:22px;
  }
  .stat-tile{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:14px 16px; box-shadow:var(--shadow);
  }
  .stat-tile .n{font-family:"IBM Plex Mono", monospace; font-size:26px; font-weight:500; color:var(--ink);}
  .stat-tile .lbl{font-size:12px; color:var(--ink-soft); margin-top:2px;}

  .panel{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:20px 22px; margin-bottom:18px; box-shadow:var(--shadow);
  }
  .panel h2{font-size:16px;}
  .panel .sub{font-size:13px; color:var(--ink-soft); margin-bottom:14px;}

  .fi-banner{
    display:flex; gap:20px; align-items:center; flex-wrap:wrap;
    background:linear-gradient(135deg,var(--accent-soft), var(--surface)); border:1px solid var(--border);
    border-radius:var(--radius); padding:18px 22px; margin-bottom:18px;
  }
  .fi-banner .big{font-family:"IBM Plex Mono",monospace; font-size:30px; color:var(--accent); font-weight:500;}
  .fi-banner .txt{flex:1; min-width:220px;}
  .fi-banner .txt h2{font-size:16px; margin-bottom:4px;}
  .fi-banner .txt p{margin:0; font-size:13px; color:var(--ink-soft);}
  .progress-bar{height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden; margin-top:8px; width:100%;}
  .progress-bar > div{height:100%; background:var(--accent); border-radius:999px;}

  .fi-note{
    border:1px solid var(--border); border-radius:10px; padding:12px 14px; font-size:13px; line-height:1.55;
    background:var(--surface-2); color:var(--ink-soft);
  }
  .fi-note.warn{background:var(--warn-soft); border-color:var(--warn); color:var(--ink);}
  .fi-note b{color:var(--ink);}
  .linklike{
    background:none; border:none; padding:0; margin:0; color:var(--accent); text-decoration:underline;
    cursor:pointer; font:inherit; font-size:inherit;
  }
  .fi-section-panel{margin-bottom:18px;}
  .fi-section-panel > .fi-section-head{
    display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:6px;
  }
  .fi-section-head h2{margin:0; flex:1;}
  .fi-sub{border-top:1px solid var(--border); padding-top:12px; margin-top:12px;}
  .fi-sub:first-of-type{border-top:none; margin-top:0; padding-top:0;}
  .fi-sub-head{display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px;}
  .fi-sub-head h3{font-size:13.5px; margin:0; flex:1; color:var(--ink);}
  .fi-sub-count{font-size:11.5px; color:var(--ink-soft); font-family:"IBM Plex Mono",monospace;}
  .fi-pre{
    white-space:pre-wrap; font-family:"IBM Plex Mono",monospace; font-size:12px; line-height:1.6;
    background:var(--surface-2); border:1px solid var(--border); border-radius:8px; padding:10px 12px;
    max-height:260px; overflow-y:auto; color:var(--ink); overflow-wrap:anywhere;
  }
  .fi-pre.empty{color:var(--ink-soft); font-style:italic;}
  .fi-flag{color:var(--warn); font-weight:600;}

  .cat-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:10px;}
  .cat-card{
    border:1px solid var(--border); border-radius:9px; padding:12px 14px; cursor:pointer;
    background:var(--surface); display:flex; flex-direction:column; gap:2px;
  }
  .cat-card:hover{border-color:var(--accent);}
  .cat-card .n{font-family:"IBM Plex Mono",monospace; font-size:19px;}
  .cat-card .l{font-size:12.5px; color:var(--ink-soft);}

  /* ---- Activity list ---- */
  .filter-row{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; align-items:center;}
  select, .yr-input{
    background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:7px 10px;
    font-size:13px; color:var(--ink); font-family:inherit;
  }
  .chip-toggle{
    display:inline-flex; align-items:center; gap:6px; border:1px solid var(--border); background:var(--surface);
    border-radius:999px; padding:6px 12px; font-size:12.5px; cursor:pointer; color:var(--ink-soft);
  }
  .chip-toggle.on{background:var(--accent-soft); border-color:var(--accent); color:var(--accent); font-weight:600;}

  .group-heading{
    font-size:11.5px; text-transform:uppercase; letter-spacing:.07em; color:var(--gold); font-weight:600;
    margin:22px 0 8px; padding-bottom:6px; border-bottom:1px solid var(--border);
  }
  .group-heading:first-child{margin-top:0;}

  .entry-row{
    display:flex; gap:14px; padding:13px 4px; border-bottom:1px solid var(--border); align-items:flex-start;
  }
  .entry-row:hover{background:var(--surface-2);}
  .entry-year{
    flex:0 0 56px; font-family:"IBM Plex Mono",monospace; font-size:13px; color:var(--ink-soft); padding-top:2px;
  }
  .entry-body{flex:1; min-width:0;}
  .entry-title{font-size:13.8px; color:var(--ink); line-height:1.5; overflow-wrap:anywhere;}
  .entry-meta{display:flex; gap:8px; margin-top:6px; flex-wrap:wrap; align-items:center;}
  .badge{
    font-size:11px; font-weight:600; padding:2px 8px; border-radius:999px; display:inline-flex; align-items:center; gap:4px;
  }
  .badge.cat{background:var(--surface-2); color:var(--ink-soft);}
  .badge.status-funded{background:var(--good-soft); color:var(--good);}
  .badge.status-underreview,.badge.status-inprogress{background:var(--warn-soft); color:var(--warn);}
  .badge.status-notfunded{background:var(--bad-soft); color:var(--bad);}
  .badge.fi-yes{background:var(--good-soft); color:var(--good);}
  .badge.fi-no{background:var(--warn-soft); color:var(--warn);}
  .entry-actions{flex:0 0 auto; display:flex; gap:4px; opacity:0; transition:opacity .1s;}
  .entry-row:hover .entry-actions{opacity:1;}
  .icon-btn{
    all:unset; cursor:pointer; width:28px; height:28px; display:flex; align-items:center; justify-content:center;
    border-radius:6px; color:var(--ink-soft);
  }
  .icon-btn:hover{background:var(--surface); color:var(--ink); border:1px solid var(--border);}

  .empty-state{padding:40px 10px; text-align:center; color:var(--ink-soft);}
  .empty-state svg{opacity:.4; margin-bottom:10px;}

  /* ---- Modal ---- */
  .modal-veil{
    position:fixed; inset:0; background:rgba(20,20,15,.45); display:flex; align-items:flex-start; justify-content:center;
    padding:5vh 16px; overflow-y:auto; z-index:50;
  }
  .modal{
    background:var(--surface); border-radius:12px; width:100%; max-width:560px; padding:24px 26px 22px;
    box-shadow:var(--shadow); border:1px solid var(--border);
  }
  .modal h3{font-size:17px; margin-bottom:16px;}
  .field{margin-bottom:14px;}
  .field label{display:block; font-size:12.5px; font-weight:600; color:var(--ink-soft); margin-bottom:5px;}
  .field input[type=text], .field input[type=number], .field textarea, .field select{
    width:100%; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:9px 11px;
    font-size:13.5px; color:var(--ink); font-family:inherit; resize:vertical;
  }
  .field textarea{min-height:90px; line-height:1.5;}
  .field-row{display:flex; gap:10px;}
  .field-row > .field{flex:1;}
  .checkbox-field{display:flex; align-items:center; gap:8px;}
  .checkbox-field input{width:16px; height:16px;}
  .modal-actions{display:flex; justify-content:space-between; gap:10px; margin-top:20px; align-items:center;}
  .modal-actions .right{display:flex; gap:8px;}

  /* ---- CV Builder ---- */
  .cv-toolbar{display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;}
  #cv-render{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow);
    padding:46px 54px; font-family:"Source Serif 4", Georgia, serif; max-width:800px; margin:0 auto;
  }
  #cv-render h1{font-size:23px; text-align:center; margin-bottom:2px;}
  #cv-render .cv-role{text-align:center; font-size:14px; color:var(--ink-soft); font-family:"IBM Plex Sans",sans-serif;}
  #cv-render .cv-contact{
    text-align:center; font-size:12px; color:var(--ink-soft); margin-top:6px; font-family:"IBM Plex Sans",sans-serif;
  }
  #cv-render .cv-section{margin-top:26px;}
  #cv-render .cv-section h2{
    font-size:13px; text-transform:uppercase; letter-spacing:.08em; border-bottom:1.5px solid var(--ink);
    padding-bottom:4px; margin-bottom:10px; font-family:"IBM Plex Sans",sans-serif; font-weight:600;
  }
  #cv-render .cv-group{font-size:12px; font-style:italic; color:var(--ink-soft); margin:10px 0 4px; font-family:"IBM Plex Sans",sans-serif;}
  #cv-render .cv-item{font-size:13.5px; margin-bottom:8px; line-height:1.55; overflow-wrap:anywhere;}
  #cv-render .cv-item .yr{font-family:"IBM Plex Mono",monospace; font-size:11.5px; color:var(--ink-soft); margin-right:8px;}

  /* ---- misc ---- */
  .toast{
    position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:var(--ink); color:var(--bg);
    padding:10px 18px; border-radius:8px; font-size:13px; z-index:99; box-shadow:var(--shadow);
    opacity:0; pointer-events:none; transition:opacity .15s, transform .15s;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(-4px);}

  #seed-overlay{
    position:fixed; inset:0; background:var(--bg); z-index:100; align-items:center; justify-content:center;
    flex-direction:column; gap:12px;
  }
  #seed-overlay:not([hidden]){display:flex;}
  #seed-overlay .spin{
    width:26px;height:26px;border-radius:50%;border:3px solid var(--border); border-top-color:var(--accent);
    animation:spin 0.8s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg);}}
  #seed-overlay p{color:var(--ink-soft); font-size:13.5px;}

  @media print{
    #rail, #topbar, .cv-toolbar{display:none !important;}
    #content{padding:0;}
    #cv-render{box-shadow:none; border:none; padding:0; max-width:100%;}
    body{background:#fff;}
  }

  @media (max-width: 860px){
    #app{display:block;}
    #rail{
      position:sticky; top:0; width:100%; height:auto; flex-direction:row; align-items:center;
      padding:12px 16px; border-right:none; border-bottom:1px solid var(--border); z-index:6; background:var(--bg);
      overflow-x:auto;
    }
    .brand{padding:0; flex:0 0 auto; margin-right:10px;}
    .brand h1{font-size:15px;}
    .brand .who{display:none;}
    nav.views{flex-direction:row; gap:4px;}
    nav.views button{padding:7px 9px; font-size:12.5px; white-space:nowrap;}
    .rail-stats{display:none;}
    #content{padding:16px 16px 60px;}
    #cv-render{padding:26px 20px;}
    .modal{padding:18px;}
  }
</style>

<div id="seed-overlay" hidden>
  <div class="spin"></div>
  <p id="seed-status">Loading your CV into the tracker…</p>
</div>

<div id="app">
  <aside id="rail">
    <div class="brand">
      <div class="kicker">Faculty Activity</div>
      <h1>CV Tracker</h1>
      <div class="who" id="who-line">Dr. Margaret A. Mosher</div>
    </div>
    <nav class="views">
      <button data-view="overview" class="active"><span class="dot"></span>Overview</button>
      <button data-view="activity"><span class="dot"></span>Activity Log</button>
      <button data-view="prep"><span class="dot"></span>Faculty Insight Prep</button>
      <button data-view="fi"><span class="dot"></span>Faculty Insight Import</button>
      <button data-view="cv"><span class="dot"></span>CV Builder</button>
    </nav>
    <div class="rail-stats">
      <div class="rail-stat"><span>Total entries</span><b id="stat-total">0</b></div>
      <div class="rail-stat"><span>In 2025–2026 window</span><b id="stat-window">0</b></div>
      <div class="rail-stat"><span>Synced</span><b id="stat-sync">—</b></div>
    </div>
  </aside>

  <main id="main">
    <div id="topbar">
      <div class="search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search-input" type="text" placeholder="Search your CV…">
      </div>
      <div class="deadline-chip" id="deadline-chip">Loading deadline…</div>
      <div class="spacer"></div>
      <button class="btn primary" id="add-entry-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
        Add activity
      </button>
    </div>

    <div id="content">

      <!-- OVERVIEW -->
      <section class="view active" id="view-overview">
        <div class="fi-banner">
          <div class="big tabular" id="fi-days">—</div>
          <div class="txt">
            <h2>KBOR reporting deadline</h2>
            <p id="fi-banner-text">Your first KU Faculty Insight report must cover Jan 2025 – Dec 2026, due 5:00 PM Monday, March 1, 2027.</p>
            <div class="progress-bar"><div id="fi-progress-fill" style="width:0%"></div></div>
          </div>
          <button class="btn" data-goto="prep">Open Faculty Insight prep →</button>
        </div>

        <div class="stat-grid" id="stat-grid"></div>

        <div class="panel">
          <h2>Activity by category</h2>
          <div class="sub">Click a category to jump to your full activity log, filtered.</div>
          <div class="cat-grid" id="cat-grid"></div>
        </div>

        <div class="panel">
          <h2>Recently added</h2>
          <div class="sub">The last few things you've logged here.</div>
          <div id="recent-list"></div>
        </div>
      </section>

      <!-- ACTIVITY LOG -->
      <section class="view" id="view-activity">
        <div class="filter-row">
          <select id="filter-category"><option value="">All categories</option></select>
          <input class="yr-input tabular" type="number" id="filter-year-min" placeholder="From year" style="width:100px;">
          <input class="yr-input tabular" type="number" id="filter-year-max" placeholder="To year" style="width:100px;">
          <button class="chip-toggle" id="filter-window-toggle">2025–2026 window only</button>
          <div class="spacer" style="flex:1"></div>
          <span class="sub" id="activity-count" style="color:var(--ink-soft); font-size:12.5px;"></span>
        </div>
        <div id="activity-list"></div>
      </section>

      <!-- FACULTY INSIGHT PREP -->
