            { domain: "Output Evaluation", q: "1. How do you know this answer is accurate?", sub: "What sources can confirm or contradict this?" },
            { domain: "Output Evaluation", q: "2. Does this response sound confident but say very little?", sub: "Check for generic AI fluff." },
            { domain: "Bias Awareness", q: "3. Whose perspective is missing from this AI output?", sub: "Consider language, culture, and training data origins." },
            { domain: "Bias Awareness", q: "4. Would the answer change in a different language?", sub: "Test cross-cultural AI assumptions." },
            { domain: "Thinking Ownership", q: "5. If I removed the AI output, what do you still know?", sub: "Ensure student retains conceptual understanding." },
            { domain: "Thinking Ownership", q: "6. Did you use AI to help you think, or to think FOR you?", sub: "Promote active agency." },
            { domain: "System Understanding", q: "7. Why does AI produce confident-sounding wrong answers?", sub: "Explain probability predictions vs truth verification." },
            { domain: "Ethical Awareness", q: "8. Whose work was used to train this model?", sub: "Discuss fair use, copyright, and creator credit." }
        ];

        let activeDomainFilter = 'All';

        function renderQuestions() {
            const domains = ['All', 'Output Evaluation', 'Bias Awareness', 'Thinking Ownership', 'System Understanding', 'Ethical Awareness'];
            const filterContainer = document.getElementById('question-domain-filters');

            filterContainer.innerHTML = domains.map(d => `
                <button onclick="filterQuestions('${d}')" class="px-3 py-1 rounded-full text-xs font-bold transition ${activeDomainFilter === d ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}">
                    ${d}
                </button>
            `).join('');

            const grid = document.getElementById('questions-display-grid');
            const filtered = activeDomainFilter === 'All' ? questionsData : questionsData.filter(q => q.domain === activeDomainFilter);

            grid.innerHTML = filtered.map(item => `
                <div class="bg-stone-50 p-4 rounded-xl border border-slate-200 space-y-1">
                    <span class="text-[10px] font-extrabold bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded-full">${item.domain}</span>
                    <h4 class="font-bold text-slate-900 text-xs mt-1">${item.q}</h4>
                    <p class="text-[11px] text-slate-500">${item.sub}</p>
                </div>
            `).join('');
        }

        function filterQuestions(domain) {
            activeDomainFilter = domain;
            renderQuestions();
        }

        // Mobile Menu Toggle Logic
        document.getElementById('mobile-menu-btn').addEventListener('click', () => {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });

        // Initialize Application
        window.addEventListener('DOMContentLoaded', () => {
            selectFamilyTab('ai');
            renderPipelineStepper();
            renderScenario();
            initCharts();
            generateTeacherPrompt();
            buildAgreement();
            renderQuestions();
        });
    </script>
</body>
</html>
