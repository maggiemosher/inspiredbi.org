<script>
  function switchTab(id, el) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.getElementById('panel-' + id).classList.add('active');
    el.classList.add('active');
  }

  const goalBank = {
    emotion: "Given a social situation involving peers, the student will identify the emotional state of others using facial expression and contextual cues with 80% accuracy across 3 consecutive sessions.",
    facial: "When presented with a peer's facial expression in a naturalistic or virtual setting, the student will correctly identify the displayed emotion with 75% accuracy across 4 of 5 opportunities.",
    complaint: "Given an undesirable situation in a school setting, the student will express a complaint using a calm tone and appropriate vocabulary in 4 of 5 observed opportunities.",
    perspective: "The student will demonstrate perspective-taking by accurately describing how a peer might feel in a given social scenario in 3 of 4 opportunities as measured by teacher observation.",
    conflict: "When a conflict arises with a peer, the student will use a problem-solving strategy (identify problem, consider solutions, choose best option) with 80% accuracy across 3 consecutive weeks.",
    body: "The student will identify at least 3 physical sensations associated with emotional states and label the corresponding emotion with 80% accuracy across structured VOISS activities.",
    annoy: "When experiencing frustration or annoyance in a social situation, the student will use a self-regulation strategy (e.g., calm voice, pause, reframe) in 4 of 5 observed opportunities.",
    convo: "The student will initiate and maintain a brief topic-relevant conversation with a peer for at least 3 exchanges in 4 of 5 observed opportunities."
  };

  function fillGoal(type) {
    document.getElementById('goalInput').value = goalBank[type];
  }

  function runMatch() {
    const val = document.getElementById('goalInput').value.trim();
    if (!val) { alert('Please paste or select a goal first.'); return; }
    document.getElementById('resultPlaceholder').style.display = 'none';
    document.getElementById('matchResult').classList.add('visible');
  }

  function selectChoice(el) {
    el.closest('.choice-grid').querySelectorAll('.choice-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
  }
</script>

